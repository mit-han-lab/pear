# shellcheck shell=bash disable=SC2034
# Sourced, not run: every version, commit, source and checksum the installer uses that is not a package of an
# environment or of a conda-forge prefix (those: the target's directory here). verl and LMCache:
# 3rdparty/<name>/UPSTREAM.

# the tools: uv's release archive and micromamba's release binary, each with its SHA-256 by machine type (uname -m)
UV_VERSION=0.12.24
UV_RELEASES_URL=https://github.com/astral-sh/uv/releases/download
UV_SHA256_aarch64=5231be65f496304623895dacdbf1de8504fec90303684bdf05805aa34414dd21
UV_SHA256_x86_64=b4dfaef47d491a7296981f8374a4595f55dbf84e8937c8ecd2983574d8bb3da6
MICROMAMBA_VERSION=2.9.0
# the build of that version: a release's tag is <version>-<build>
MICROMAMBA_BUILD=0
MICROMAMBA_RELEASES_URL=https://github.com/mamba-org/micromamba-releases/releases/download
MICROMAMBA_SHA256_aarch64=9f93b974adcb4d166996af969b6cd371287d1a3e52733704727884d9b74cb7a7
MICROMAMBA_SHA256_x86_64=366cd9cd8be14df1ab8ed50352a82111082a36686b2d389fdb79a92c3fafb3e3
# the channel of what PyPI lacks: Mesa, ImageMagick, numactl
CONDA_CHANNEL=conda-forge

# the training and rollout environment
VERL_PYTHON_VERSION=3.12.15
# torch's and vLLM's CUDA 13 builds, whose toolkit pieces go into the environment
CUDA_TAG=cu130
# the compute capabilities the source builds know: a GB300's, which a machine without a GPU builds for, and an H100's,
# whose actor runs flash-attn 3
BLACKWELL_CUDA_ARCH=10.3
HOPPER_CUDA_ARCH=9.0
# FlashInfer's precompiled kernels (flashinfer-cubin), which PyPI does not carry at flashinfer-python's version: the
# page of FlashInfer's own index that lists the wheels
FLASHINFER_CUBIN_WHEELS_URL=https://flashinfer.ai/whl/flashinfer-cubin/
# flash-attn 3 (Hopper), built from source on an H100 machine
FLASH_ATTN_3_URL=https://github.com/Dao-AILab/flash-attention.git
FLASH_ATTN_3_COMMIT=eed1971f5132630dc296fe37601e834d4b57a248

# the LIBERO simulator environment
LIBERO_PYTHON_VERSION=3.10.22
LIBERO_URL=https://github.com/Lifelong-Robot-Learning/LIBERO.git
LIBERO_COMMIT=8f1084e3132a39270c3a13ebe37270a43ece2a01

# the LIBERO-plus simulator environment
LIBERO_PLUS_PYTHON_VERSION=3.10.22
LIBERO_PLUS_URL=https://github.com/sylvestf/LIBERO-plus.git
LIBERO_PLUS_COMMIT=4976dc30028e805ff8094b55501d532c48fec182
# its scenes' assets, a Hugging Face dataset
LIBERO_PLUS_ASSETS_REPO=Sylvest/LIBERO-plus
LIBERO_PLUS_ASSETS_REVISION=dd2bd61b7d9a6fef1abc52d606e983b41886a149
LIBERO_PLUS_ASSETS_SHA256=96764a4bfbdaea98d4411598caeab235458318fe0f549611b93d1a323027b3cf

# the LIBERO-PRO simulator environment
LIBERO_PRO_PYTHON_VERSION=3.10.22
LIBERO_PRO_URL=https://github.com/Zxy-MLlab/LIBERO-PRO.git
LIBERO_PRO_COMMIT=eafdb809426b13153aa1e4c42d6601844217dfec
# its perturbed tasks, a Hugging Face dataset
LIBERO_PRO_TASKS_REPO=zhouxueyang/LIBERO-Pro
LIBERO_PRO_TASKS_REVISION=c86fc3b8293185a6f373677018ff3e37f8391602

# the Ray environment of RoboDojo's simulator machines: the training environment's Python, whose cluster they join
ROBODOJO_PYTHON_VERSION=$VERL_PYTHON_VERSION
# where NVIDIA serves a driver's runfile with its checksum, by the driver's version
NVIDIA_DRIVERS_URL=https://us.download.nvidia.com/XFree86/Linux-x86_64

# RoboLab's runtime and environment (RoboLab 0.3.1)
ROBOLAB_PYTHON_VERSION=3.11.17
ROBOLAB_URL=https://github.com/NVlabs/RoboLab.git
ROBOLAB_COMMIT=ad45d4f974725d020f82c2b0d77d78533aeba2b3
# Ubuntu's archive of each Debian architecture, for the host libraries: packages of the release pocket, which is
# frozen, so its pool keeps them for the life of the release
UBUNTU_ARCHIVE_URL_amd64=https://archive.ubuntu.com/ubuntu
UBUNTU_ARCHIVE_URL_arm64=https://ports.ubuntu.com/ubuntu-ports

# the general evaluation's environment
EVALSCOPE_PYTHON_VERSION=3.12.15

# the robot station's environment
STATION_PYTHON_VERSION=3.12.15
# the YAM arms' SDK, which PyPI does not carry
I2RT_URL=https://github.com/i2rt-robotics/i2rt.git
I2RT_COMMIT=120c3c81400171174604e503943f8d1ebc891058

# the model server's environment: the training environment's Python, whose pins it is installed at
SERVER_PYTHON_VERSION=$VERL_PYTHON_VERSION
