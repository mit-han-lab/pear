+def usable_key_indices(
+    num_keys: int, group_windows: Sequence[int], group_ranks: Sequence[int]
+) -> list[int]:
+    """Return the indices of the chunk-major keys (chunk, object group, kv rank)
+    that a later lookup on the same prefix can still use, in touch order: the
+    last ``window`` chunks of each windowed group, then every full-attention
+    group (window ``-1``) chunk by chunk."""
+    stride = sum(group_ranks)
+    if stride == 0:
+        return []
+    num_chunks = num_keys // stride
+    window_indices: list[int] = []
+    full_indices: list[int] = []
+    for chunk in range(num_chunks):
+        base = chunk * stride
+        for window, ranks in zip(group_windows, group_ranks, strict=True):
+            if window < 0:
+                full_indices.extend(range(base, base + ranks))
+            elif chunk >= num_chunks - window:
+                window_indices.extend(range(base, base + ranks))
+            base += ranks
+    # the LRU walks a touched list backwards: the window pages, without which
+    # the prefix is unusable, end up most recent, a full group's tail least
+    return window_indices + full_indices
+
+
 def resolve_prefetched_obj_keys(
