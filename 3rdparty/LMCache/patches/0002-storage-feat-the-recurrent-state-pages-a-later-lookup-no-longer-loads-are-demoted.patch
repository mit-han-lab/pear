 """LookupModule: lookup, prefetch polling, and session lifecycle."""
 
 # Standard
+from collections.abc import Sequence
 from dataclasses import dataclass
 from functools import partial
 import threading
@@ -32,6 +33,46 @@ from lmcache.v1.multiprocess.token_hasher import TokenHasher
 logger = init_logger(__name__)
 
 
+def usable_key_indices(
+    num_keys: int, group_windows: Sequence[int], world_size: int
+) -> list[int]:
+    """Indices of the chunk-major keys (``chunk -> object group -> kv_rank``) a
+    later lookup on the same prefix can still use, in touch order.
+
+    Every chunk of a full-attention group (window ``-1``) stays usable; of a
+    sliding-window / recurrent-state group only the last ``window`` chunks do,
+    which is exactly what the retrieve path loads (``num_objects_to_skip``).
+
+    The LRU policy walks a touched list backwards, so the first entries end up
+    most recent: the window pages come first (without them the whole prefix is
+    unusable), then the full-attention keys in chunk order (a prefix match
+    starts at chunk 0, so its tail is the right end to lose first).
+
+    Args:
+        num_keys: Length of the flat chunk-major key list.
+        group_windows: Per-object-group windows in chunks (``-1`` = full).
+        world_size: Number of kv_rank shards per chunk.
+
+    Returns:
+        Usable key indices, window-group keys first, then full groups.
+    """
+    num_groups = len(group_windows)
+    stride = num_groups * world_size
+    if stride == 0 or num_keys == 0:
+        return []
+    num_chunks = num_keys // stride
+    window_keys: list[int] = []
+    full_keys: list[int] = []
+    for chunk in range(num_chunks):
+        for group, window in enumerate(group_windows):
+            base = chunk * stride + group * world_size
+            if window < 0:
+                full_keys.extend(range(base, base + world_size))
+            elif chunk >= num_chunks - window:
+                window_keys.extend(range(base, base + world_size))
+    return window_keys + full_keys
+
+
 def resolve_prefetched_obj_keys(
     ctx: MPCacheServerContext,
     key: IPCCacheServerKey,
@@ -579,11 +620,26 @@ class LookupModule:
 
         chunk_hashes = [TokenHasher.hash_to_bytes(h) for h in session.get_hashes(0)]
         obj_keys = self._chunk_major_object_keys(session.lookup_ipc_key, chunk_hashes)
-        # unified touch of all keys, which include retrieved and stored keys
+        # unified touch of the keys a later lookup can still use (retrieved and
+        # stored): every chunk of a full-attention group, but only the last
+        # `window` chunks of a sliding-window / recurrent-state group. Earlier
+        # pages of those groups are never read again; touching them would keep
+        # superseded pages as recent as live data and make eviction take live
+        # prefixes instead.
         # TODO(chunxiaozheng): when l2 is enabled, the prefetched keys from l2 are temp
         #  and will be deleted after finish_read_prefetched, when we touch all keys,
         #  these keys has been deleted and will not be touched.
-        self._ctx.storage_manager.touch_l1_keys(obj_keys)
+        attn_desc = self._ctx.layout_desc_registry.find_attn_desc(
+            session.lookup_ipc_key.model_name, session.lookup_ipc_key.world_size
+        )
+        windows = session.prefetch_group_windows
+        if len(windows) != attn_desc.num_object_groups:
+            windows = tuple(attn_desc.num_chunks_in_sw)
+        usable = usable_key_indices(len(obj_keys), windows, attn_desc.world_size)
+        self._ctx.storage_manager.touch_l1_keys([obj_keys[i] for i in usable])
+        superseded = [obj_keys[i] for i in range(len(obj_keys)) if i not in set(usable)]
+        if superseded:
+            self._ctx.storage_manager.demote_l1_keys(superseded)
 
