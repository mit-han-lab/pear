-        # unified touch of all keys, which include retrieved and stored keys
+        obj_keys, group_windows, group_ranks = self._chunk_major_object_keys(
+            session.lookup_ipc_key, chunk_hashes
+        )
+        # unified touch of the keys a later lookup can still use, retrieved and
+        # stored; the earlier pages of a windowed group are demoted, or they stay
+        # as recent as live data and eviction takes live prefixes instead
         # TODO(chunxiaozheng): when l2 is enabled, the prefetched keys from l2 are temp
         #  and will be deleted after finish_read_prefetched, when we touch all keys,
         #  these keys has been deleted and will not be touched.
-        self._ctx.storage_manager.touch_cached_keys(obj_keys)
+        usable_indices = usable_key_indices(len(obj_keys), group_windows, group_ranks)
+        self._ctx.storage_manager.touch_cached_keys(
+            [obj_keys[i] for i in usable_indices]
+        )
+        usable_index_set = set(usable_indices)
+        superseded_keys = [
+            key for i, key in enumerate(obj_keys) if i not in usable_index_set
+        ]
+        if superseded_keys:
+            self._ctx.storage_manager.demote_l1_keys(superseded_keys)
 
     # -----------------------------------------------------------------
     # Internal helpers
     # -----------------------------------------------------------------
 
+    def _chunk_major_object_keys(
+        self,
+        key: IPCCacheServerKey,
+        chunk_hashes: list[bytes],
+    ) -> tuple[list[ObjectKey], list[int], list[int]]:
+        """Return every object key of the chunks across the registration's object
+        groups, ordered chunk, object group, kv rank, with each group's window in
+        chunks and its number of kv-rank keys per chunk."""
+        registry = self._ctx.layout_desc_registry
+        attn_desc = registry.find_attn_desc(key.model_name, key.world_size)
+        shard_replication_desc = registry.find_shard_replication_desc(
+            key.model_name, key.world_size
+        )
+        keys_by_group = ipc_key_to_object_keys(
+            key,
+            chunk_hashes,
+            list(range(attn_desc.num_object_groups)),
+            shard_replication_desc,
+        )
+        # Each per-group list is chunk-major / rank-minor; a replicated group
+        # has fewer kv ranks per chunk than a per-rank one.
+        num_chunks = len(chunk_hashes)
+        group_ranks = [
+            len(group_keys) // num_chunks if num_chunks else 0
+            for group_keys in keys_by_group
+        ]
+        obj_keys: list[ObjectKey] = []
+        for chunk_idx in range(num_chunks):
+            for group_keys, ranks in zip(keys_by_group, group_ranks, strict=True):
+                obj_keys.extend(group_keys[chunk_idx * ranks : (chunk_idx + 1) * ranks])
+        return obj_keys, list(attn_desc.num_chunks_in_sw), group_ranks
+
