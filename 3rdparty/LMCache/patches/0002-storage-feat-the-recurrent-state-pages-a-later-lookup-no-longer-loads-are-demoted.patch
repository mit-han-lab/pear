+def test_end_session_touches_the_window_and_demotes_the_rest():
+    """At session end the recurrent group (stored once per tensor-parallel
+    group here) keeps only its last chunk; every attention key is touched."""
+    num_chunks = 4
+    chunk_size = 16
+    ctx = MagicMock()
+    ctx.layout_desc_registry.find_attn_desc.return_value = AttnWindowDesc(
+        num_chunks_in_sw=[1, -1], world_size=RANKS
+    )
+    ctx.layout_desc_registry.find_shard_replication_desc.return_value = (
+        ShardReplicationDesc(group_tp_replicas=(RANKS, 1), group_dcp_shards=(1, 1))
+    )
+    session = MagicMock()
+    session.lookup_ipc_key = IPCCacheServerKey.from_token_ids(
+        model_name="m",
+        world_size=RANKS,
+        worker_id=None,
+        token_ids=range(num_chunks * chunk_size),
+        start=0,
+        end=num_chunks * chunk_size,
+        request_id="r",
+    )
+    session.get_hashes.return_value = list(range(1, num_chunks + 1))
+    ctx.session_manager.remove.return_value = session
+
+    LookupModule(ctx).end_session("r")
+
+    last_chunk = TokenHasher.hash_to_bytes(num_chunks)
+    touched_keys = ctx.storage_manager.touch_cached_keys.call_args.args[0]
+    assert [(k.object_group_id, k.chunk_hash) for k in touched_keys[:1]] == [
+        (0, last_chunk)
+    ]
+    assert [k.object_group_id for k in touched_keys[1:]] == [1] * (num_chunks * RANKS)
+    demoted_keys = ctx.storage_manager.demote_l1_keys.call_args.args[0]
+    assert [(k.object_group_id, k.chunk_hash) for k in demoted_keys] == [
+        (0, TokenHasher.hash_to_bytes(chunk)) for chunk in range(1, num_chunks)
+    ]
+
+
+def _rows(windows: list[int], num_chunks: int) -> list[GroupedObjectKeys]:
+    """One prefetch row per object group (kv rank 0), chunk-ordered."""
+    return [
+        GroupedObjectKeys(
+            keys=[key(0, c, g, 0) for c in range(num_chunks)],
+            object_group_id=g,
+            layout_desc=LAYOUT,
+            sliding_window_size=window,
+        )
+        for g, window in enumerate(windows)
+    ]
+
+
+def _set_bits(grid: Bitmap2D) -> list[list[int]]:
+    return [[i for i in range(row.size()) if row.test(i)] for row in grid.to_list()]
+
+
+def _l1_holding(rows: list[GroupedObjectKeys], num_chunks: int) -> MapState:
+    """One L1 manager holding the first ``num_chunks`` chunks of every row."""
+    state = MapState()
+    state[0] = Bitmap2D([Bitmap(len(row.keys), num_chunks) for row in rows])
+    return state
+
+
+def test_superseded_cells_are_the_pages_before_each_window():
+    rows = _rows([1, 2, -1], num_chunks=4)
+
+    superseded_cells = _superseded_cells(
+        rows, _l1_holding(rows, 4), MapState(), "prefix"
+    )
+    assert _set_bits(superseded_cells) == [[0, 1, 2], [0, 1], []]
+
+    # the hit, not the request, sets the windows
+    superseded_cells = _superseded_cells(
+        rows, _l1_holding(rows, 2), MapState(), "prefix"
+    )
+    assert _set_bits(superseded_cells) == [[0], [], []]
+
+    full_rows = _rows([-1, -1], num_chunks=4)
+    superseded_cells = _superseded_cells(
+        full_rows, _l1_holding(full_rows, 4), MapState(), "full"
+    )
+    assert _set_bits(superseded_cells) == [[], []]
+
