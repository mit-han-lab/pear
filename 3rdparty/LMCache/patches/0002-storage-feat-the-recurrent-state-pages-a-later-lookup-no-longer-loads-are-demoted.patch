diff --git a/tests/v1/distributed/test_superseded_page_demotion.py b/tests/v1/distributed/test_superseded_page_demotion.py
new file mode 100644
index 0000000000000000000000000000000000000000..ac323181d47284352c885e8484a65e7a2a9a97b3
--- /dev/null
+++ b/tests/v1/distributed/test_superseded_page_demotion.py
@@ -0,0 +1,99 @@
+"""Superseded recurrent-state / sliding-window pages must be evicted before live keys.
+
+A hybrid model stores one recurrent-state page per chunk per group, but a later lookup on the same prefix only
+loads the last ``window`` chunks of such a group. Those earlier pages are demoted (``on_keys_demoted``) by the
+prefetch controller and no longer touched at session end, so the LRU must hand them out first and never move
+them back to the MRU end through the prefix run.
+"""
+
+from lmcache.v1.distributed.api import ObjectKey
+from lmcache.v1.distributed.eviction_policy.lru import LRUEvictionPolicy
+from lmcache.v1.multiprocess.modules.lookup import usable_key_indices
+
+RANKS = 2
+GROUPS = [1, 1, -1]  # two recurrent groups with a one-chunk window, one full-attention group
+
+
+def key(conv: int, chunk: int, group: int, rank: int) -> ObjectKey:
+    return ObjectKey(chunk_hash=f"c{conv}-{chunk}".encode(), model_name="m", kv_rank=rank, object_group_id=group)
+
+
+def chunk_keys(conv: int, chunk: int) -> list[ObjectKey]:
+    return [key(conv, chunk, g, r) for g in range(len(GROUPS)) for r in range(RANKS)]
+
+
+def prefix_keys(conv: int, num_chunks: int) -> list[ObjectKey]:
+    return [k for c in range(num_chunks) for k in chunk_keys(conv, c)]
+
+
+def usable_keys(conv: int, num_chunks: int) -> list[ObjectKey]:
+    keys = prefix_keys(conv, num_chunks)
+    return [keys[i] for i in usable_key_indices(len(keys), GROUPS, RANKS)]
+
+
+def test_usable_key_indices_layout():
+    keys = prefix_keys(0, 3)
+    usable = [keys[i] for i in usable_key_indices(len(keys), GROUPS, RANKS)]
+    # full-attention group: all chunks; recurrent groups: only the last chunk
+    assert {(k.object_group_id, int(k.chunk_hash.split(b"-")[1])) for k in usable} == {
+        (2, 0), (2, 1), (2, 2), (0, 2), (1, 2)
+    }
+    assert usable_key_indices(0, GROUPS, RANKS) == []
+    assert usable_key_indices(12, [], RANKS) == []
+    # touch order: the window pages first (most recent after a reversed walk), then attention keys chunk by chunk
+    ordered = [keys[i] for i in usable_key_indices(len(keys), GROUPS, RANKS)]
+    assert [k.object_group_id for k in ordered] == [0] * RANKS + [1] * RANKS + [2] * (3 * RANKS)
+    assert [int(k.chunk_hash.split(b"-")[1]) for k in ordered][2 * RANKS:] == [0] * RANKS + [1] * RANKS + [2] * RANKS
+
+
+def _store_chunks(policy: LRUEvictionPolicy, conv: int, chunks: range) -> None:
+    note_positions = getattr(policy, "note_key_positions", None)  # only with PR #4867's prefix-run ordering
+    for c in chunks:
+        ks = chunk_keys(conv, c)
+        if note_positions is not None:
+            note_positions(ks, [c] * len(ks))
+        policy.on_keys_created(ks)
+
+
+def _victims(policy: LRUEvictionPolicy, count: int) -> list[ObjectKey]:
+    tracked = len(policy._order)
+    return [k for a in policy.get_eviction_actions(count / tracked) for k in a.keys][:count]
+
+
+def test_demoted_pages_are_evicted_first_and_stay_demoted():
+    policy = LRUEvictionPolicy()
+    _store_chunks(policy, 0, range(4))
+    _store_chunks(policy, 1, range(4))
+    superseded = [k for k in prefix_keys(0, 4) if k not in set(usable_keys(0, 4))]
+    policy.on_keys_demoted(superseded)
+    # a later touch of the prefix, an extension by one chunk (store of chunk 4 only, as the server dedups
+    # existing chunks) and a re-touch must not carry the demoted pages back to the MRU end
+    policy.on_keys_touched(usable_keys(0, 4))
+    _store_chunks(policy, 0, range(4, 5))
+    policy.on_keys_touched(usable_keys(0, 5))
+
+    victims = _victims(policy, len(superseded))
+    assert victims, "policy returned no eviction candidates"
+    assert set(victims) == set(superseded), f"eviction did not take the superseded pages first: {set(victims) ^ set(superseded)}"
+
+
+def test_recreating_a_demoted_page_does_not_promote_it():
+    policy = LRUEvictionPolicy()
+    _store_chunks(policy, 0, range(3))
+    superseded = [k for k in prefix_keys(0, 3) if k not in set(usable_keys(0, 3))]
+    policy.on_keys_demoted(superseded)
+    # a redundant store of the whole prefix (e.g. a retried request) reports every key as created again
+    _store_chunks(policy, 0, range(3))
+    policy.on_keys_touched(prefix_keys(0, 3))
+    assert set(_victims(policy, len(superseded))) == set(superseded)
+    # once the pages are really gone they are forgotten and can be admitted afresh
+    policy.on_keys_removed(superseded)
+    assert not getattr(policy, "_demoted", set())
+    _store_chunks(policy, 0, range(3))
+    assert set(_victims(policy, 1)) <= set(prefix_keys(0, 3))
+
+
+def test_demotion_of_unknown_keys_is_a_noop():
+    policy = LRUEvictionPolicy()
+    policy.on_keys_demoted([key(9, 0, 0, 0)])
+    assert policy.get_eviction_actions(1.0) == []
