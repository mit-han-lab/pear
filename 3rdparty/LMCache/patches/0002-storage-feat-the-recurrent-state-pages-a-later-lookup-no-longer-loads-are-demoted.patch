+    def on_keys_demoted(self, keys: list[ObjectKey]):
+        """
+        Notify the eviction policy that keys are superseded (recurrent-state /
+        sliding-window pages behind the window of a longer prefix). They are
+        moved to the least-recently-used end so the next eviction takes them
+        before any live key, and remembered so that a later touch or store of
+        the same key does not carry them back to the MRU end.
+
+        Args:
+            keys (list[ObjectKey]): The superseded keys
+        """
+        if not keys:
+            return
+        with self._lock:
+            for key in keys:
+                if key in self._order:
+                    self._order.move_to_end(key, last=False)
+                    self._demoted.add(key)
+
