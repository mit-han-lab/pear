+pytestmark = pytest.mark.no_shared_allocator
+
+# kv-rank keys per chunk of every group
+RANKS = 2
+# two recurrent groups with a one-chunk window, one full-attention group
+GROUPS = [1, 1, -1]
+LAYOUT = MemoryLayoutDesc([torch.Size([1024])], [torch.float32])  # 4 KiB
+# the L1 tier, 32 objects of LAYOUT
+CAPACITY = 32 * 4096
+
+
+def key(conv: int, chunk: int, group: int, rank: int) -> ObjectKey:
+    return ObjectKey(
+        chunk_hash=f"c{conv}-{chunk}".encode(),
+        model_name="m",
+        kv_rank=rank,
+        object_group_id=group,
+    )
+
+
+def chunk_keys(conv: int, chunk: int) -> list[ObjectKey]:
+    return [key(conv, chunk, g, r) for g in range(len(GROUPS)) for r in range(RANKS)]
+
+
+def prefix_keys(conv: int, num_chunks: int) -> list[ObjectKey]:
+    return [k for c in range(num_chunks) for k in chunk_keys(conv, c)]
+
+
+def usable_keys(conv: int, num_chunks: int) -> list[ObjectKey]:
+    keys = prefix_keys(conv, num_chunks)
+    group_ranks = [RANKS] * len(GROUPS)
+    return [keys[i] for i in usable_key_indices(len(keys), GROUPS, group_ranks)]
+
+
+def chunk_of(k: ObjectKey) -> int:
+    return int(k.chunk_hash.split(b"-")[1])
+
+
+def test_usable_key_indices_layout():
+    keys = prefix_keys(0, 3)
+    group_ranks = [RANKS] * len(GROUPS)
+    usable_key_list = [
+        keys[i] for i in usable_key_indices(len(keys), GROUPS, group_ranks)
+    ]
+    # full-attention group: all chunks; recurrent groups: only the last chunk
+    assert {(k.object_group_id, chunk_of(k)) for k in usable_key_list} == {
+        (2, 0),
+        (2, 1),
+        (2, 2),
+        (0, 2),
+        (1, 2),
+    }
+    assert usable_key_indices(0, GROUPS, group_ranks) == []
+    assert usable_key_indices(12, [], []) == []
+    # touch order: the window pages first (most recent after a reversed walk),
+    # then the attention keys chunk by chunk
+    assert [k.object_group_id for k in usable_key_list] == (
+        [0] * RANKS + [1] * RANKS + [2] * (3 * RANKS)
+    )
+    assert [chunk_of(k) for k in usable_key_list][2 * RANKS :] == (
+        [0] * RANKS + [1] * RANKS + [2] * RANKS
+    )
+
+
+def test_usable_key_indices_with_a_group_stored_once():
+    """A group stored once per tensor-parallel group has one key per chunk
+    while the other groups keep one per rank."""
+    # chunk-major: (group 0, rank 0), (group 1, rank 0), (group 1, rank 1)
+    usable_indices = usable_key_indices(12, [1, -1], [1, 2])
+
+    assert usable_indices == [9, 1, 2, 4, 5, 7, 8, 10, 11]
+
+
+def _store_chunks(policy: LRUEvictionPolicy, conv: int, chunks: range) -> None:
+    for c in chunks:
+        policy.on_keys_created(chunk_keys(conv, c))
+
+
+def _victims(policy: LRUEvictionPolicy, count: int) -> list[ObjectKey]:
+    num_tracked_keys = len(policy._order)
+    actions = policy.get_eviction_actions(count / num_tracked_keys)
+    return [k for a in actions for k in a.keys][:count]
+
+
+def test_demoted_pages_are_evicted_first_and_stay_demoted():
+    policy = LRUEvictionPolicy()
+    _store_chunks(policy, 0, range(4))
+    _store_chunks(policy, 1, range(4))
+    superseded_keys = [k for k in prefix_keys(0, 4) if k not in set(usable_keys(0, 4))]
+    policy.on_keys_demoted(superseded_keys)
+    # a later touch of the prefix, an extension by one chunk (store of chunk 4
+    # only, as the server dedups existing chunks) and a re-touch must not carry
+    # the demoted pages back to the MRU end
+    policy.on_keys_touched(usable_keys(0, 4))
+    _store_chunks(policy, 0, range(4, 5))
+    policy.on_keys_touched(usable_keys(0, 5))
+
+    victims = _victims(policy, len(superseded_keys))
+    assert victims, "policy returned no eviction candidates"
+    assert set(victims) == set(superseded_keys), (
+        "eviction did not take the superseded pages first: "
+        f"{set(victims) ^ set(superseded_keys)}"
+    )
+
+
+def test_recreating_a_demoted_page_does_not_promote_it():
+    policy = LRUEvictionPolicy()
+    _store_chunks(policy, 0, range(3))
+    superseded_keys = [k for k in prefix_keys(0, 3) if k not in set(usable_keys(0, 3))]
+    policy.on_keys_demoted(superseded_keys)
+    # a redundant store of the whole prefix (e.g. a retried request) reports
+    # every key as created again
+    _store_chunks(policy, 0, range(3))
+    policy.on_keys_touched(prefix_keys(0, 3))
+    assert set(_victims(policy, len(superseded_keys))) == set(superseded_keys)
+    # once the pages are really gone they are forgotten and can be admitted
+    # afresh
+    policy.on_keys_removed(superseded_keys)
+    assert not policy._demoted_keys
+    _store_chunks(policy, 0, range(3))
+    assert set(_victims(policy, 1)) <= set(prefix_keys(0, 3))
+
+
+def test_demotion_of_unknown_keys_is_a_noop():
+    policy = LRUEvictionPolicy()
+    policy.on_keys_demoted([key(9, 0, 0, 0)])
+    assert policy.get_eviction_actions(1.0) == []
