+def test_a_prefix_prefetch_demotes_the_pages_it_supersedes(dram_l1: DramL1Manager):
+    """The pages of a recurrent-state row before its window, released by a
+    prefix prefetch, become the L1 LRU's first eviction candidates."""
+    policy = LRUEvictionPolicy()
+    dram_l1.register_listener(L1EvictionPolicy(policy))
+    rows = _rows([1, -1], num_chunks=4)
+    keys = [k for row in rows for k in row.keys]
+    write_results = dram_l1.reserve_write(keys, [False] * len(keys), LAYOUT)
+    assert all(write_results[k][0] == L1Error.SUCCESS for k in keys)
+    dram_l1.finish_write(keys)
+    controller = PrefetchController(
+        l1_managers=[dram_l1],
+        l1_manager_descriptors=[L1ManagerDescriptor(index=0, config=dram_l1.config)],
+        l2_adapters=[],
+        adapter_descriptors=[],
+        policy=DefaultPrefetchPolicy(),
+    )
+
+    request_id = controller.submit_prefetch_request(PrefetchTaskSpec(key_groups=rows))
+    result = controller.query_prefetch_result(request_id)
+
+    assert result is not None
+    assert [[i for i in range(4) if row.test(i)] for row in result.hit_cells] == [
+        [3],
+        [0, 1, 2, 3],
+    ]
+    superseded_keys = rows[0].keys[:3]
+    # a later touch, as a store of the same chunks makes, leaves them first
+    policy.on_keys_touched(superseded_keys)
+    assert set(policy.get_eviction_candidates(len(superseded_keys))) == set(
+        superseded_keys
+    )
+    dram_l1.finish_read(rows[0].keys[3:] + rows[1].keys)
