From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pear <pear@localhost>
Date: Mon, 17 Sep 2001 00:00:00 +0000
Subject: [PATCH] [mp] fix: a lookup miss on a scheduler retry clears the hit
 an earlier poll recorded

After LMCache pull request #4520, "[Bugfix][MP] Make lookup accounting retry-safe"
(https://github.com/LMCache/LMCache/pull/4520, issue #4508), at its revision
9555c667cef3142fd053001940ff85df9fe404a5, ported onto the commit of UPSTREAM.

vLLM calls get_num_new_matched_tokens again on every scheduler step for a waiting request whose block allocation
failed. LMCache pull request #5248 (9a7b6050) assigns the lookup hit to the tracker's num_stored_tokens instead of
adding it on every call, so a repeated answer no longer moves the watermark; but the method returns on a miss before
it assigns, and the adapter answers 0 once a server is unhealthy (check_lookup_result). A request whose earlier poll
found a hit then keeps that hit as its stored-token watermark and LMCache hit count: the chunks below it, which the
request computes itself, are never stored, and the next lookup of the conversation misses them. A miss is now
recorded like any other result.

What the port takes and changes:
- Of the pull request's accounting only the miss: #5248's assignment does what its account_lookup_result does, and
  nothing else changes num_stored_tokens while a request waits, so the tracker keeps no _accounted_lookup_tokens. The
  bypass after a failed asynchronous load and the re-lookup after an APC shrink reset both counters already.
- Both hit counters are recorded before the early return of an LMCache miss, which the pull request removes;
  v0.5.8rc1 records the vLLM hit count there already.
- v0.5.8rc1 also records an unfull chunk a hit ends with (#5886) among the chunks taken as stored
  (unfull_chunk_boundaries), so a later answer withdraws the ones above it: an earlier unfull hit that a retry no
  longer finds is then stored by the request again, as its full chunks are.
- The tests (tests/v1/test_mp_connector_lookup_retry.py, five cases) are the port's own, on v0.5.8rc1's lookup call
  (packed token ids, the reserved last token, the unfull chunk, the start) and the tracker's num_prompt_tokens and
  lora_request; their store ranges include the decode chunks, which v0.5.8rc1 leaves out by default
  (save_decode_cache).
---
 .../integration/vllm/lmcache_mp_connector.py  |  12 +-
 tests/v1/test_mp_connector_lookup_retry.py    | 173 ++++++++++++++++++
 2 files changed, 182 insertions(+), 3 deletions(-)
 create mode 100644 tests/v1/test_mp_connector_lookup_retry.py

diff --git a/lmcache/integration/vllm/lmcache_mp_connector.py b/lmcache/integration/vllm/lmcache_mp_connector.py
index e2ad48ce1c3c991471004730bd5ffe85fa6909f0..67cf5176130110a03b5a9c31671105ce233ba8cb 100644
--- a/lmcache/integration/vllm/lmcache_mp_connector.py
+++ b/lmcache/integration/vllm/lmcache_mp_connector.py
@@ -1555,18 +1555,24 @@ class LMCacheMPConnector(KVConnectorBase_V1, SupportsHMA):
                 tracker.lookup_started_at = time.monotonic()
             return None, True
 
-        if ret == 0:
-            return 0, False
-
         # A hit ending with an unfull chunk loads it even when vLLM's prefix
         # cache already holds part of it: the retrieve skips those tokens
         # (``skip_first_n_tokens``), as it does for a full chunk.
         full_chunk_tokens = ret - ret % self.scheduler_adapter.lmcache_tokens_per_chunk
+        # A retry of a waiting request answers from the cached lookup, or 0 once
+        # a server is unhealthy: the latest answer, a miss too, replaces an
+        # earlier hit in the stored-token watermark and the unfull chunks
         tracker.num_stored_tokens = full_chunk_tokens
         tracker.num_lmcache_hit_tokens = ret
+        tracker.unfull_chunk_boundaries = {
+            boundary for boundary in tracker.unfull_chunk_boundaries if boundary <= ret
+        }
         if ret != full_chunk_tokens:
             tracker.unfull_chunk_boundaries.add(ret)
 
+        if ret == 0:
+            return 0, False
+
         need_to_load = max(0, ret - num_computed_tokens)
 
         if request.status == RequestStatus.PREEMPTED:
diff --git a/tests/v1/test_mp_connector_lookup_retry.py b/tests/v1/test_mp_connector_lookup_retry.py
new file mode 100644
index 0000000000000000000000000000000000000000..df015f9c02adb46bff0787e811936a9468936195
--- /dev/null
+++ b/tests/v1/test_mp_connector_lookup_retry.py
@@ -0,0 +1,173 @@
+# SPDX-License-Identifier: Apache-2.0
+# Standard
+from typing import Any
+from unittest.mock import MagicMock
+
+# Third Party
+import pytest
+
+pytest.importorskip("vllm", reason="MP connector imports vLLM at module top")
+
+# Third Party
+from vllm.v1.request import RequestStatus  # noqa: E402
+from vllm.v1.utils import ConstantList  # noqa: E402
+
+# First Party
+from lmcache.integration.vllm.lmcache_mp_connector import (  # noqa: E402
+    LMCacheMPConnector,
+)
+from lmcache.integration.vllm.lmcache_mp_metadata import (  # noqa: E402
+    LMCacheMPRequestMetadata,
+    LMCacheMPRequestTracker,
+)
+
+# tokens per LMCache chunk
+CHUNK = 4
+# the prompt's tokens; a request's later tokens are generated
+NUM_PROMPT_TOKENS = 4
+
+
+class _FakeRequest:
+    def __init__(self, token_ids: list[int], status: RequestStatus) -> None:
+        self.request_id = "req-0"
+        self.cache_salt = ""
+        self.lora_request = None
+        self.prompt_token_ids = list(token_ids[:NUM_PROMPT_TOKENS])
+        self.num_prompt_tokens = NUM_PROMPT_TOKENS
+        self._token_ids = list(token_ids)
+        self.all_token_ids = ConstantList(self._token_ids)
+        self.mm_features: list[Any] = []
+        self.status = status
+        self.num_computed_tokens = 0
+
+
+class _CachedLookupAdapter:
+    """Answers one finished lookup until it is cleaned up, as the real adapter
+    does; ``results`` past the first are the answers of later retries."""
+
+    lmcache_tokens_per_chunk = CHUNK
+
+    def __init__(self, results: list[int | None]) -> None:
+        self._results = list(results)
+
+    def maybe_submit_lookup_request(
+        self,
+        request_id: str,
+        packed_token_ids: bytes,
+        cache_salt: str = "",
+        request_configs: dict[str, Any] | None = None,
+        reserve_last_token: bool = False,
+        include_unfull_chunk: bool = False,
+        start: int = 0,
+    ) -> bool:
+        del request_id, packed_token_ids, cache_salt, request_configs
+        del reserve_last_token, include_unfull_chunk, start
+        return True
+
+    def check_lookup_result(self, request_id: str) -> int | None:
+        del request_id
+        return self._results.pop(0) if len(self._results) > 1 else self._results[0]
+
+
+def _make_connector(adapter: _CachedLookupAdapter) -> LMCacheMPConnector:
+    connector = object.__new__(LMCacheMPConnector)
+    connector.request_trackers = {}
+    connector.scheduler_adapter = adapter
+    connector.lazy_offload = False
+    connector._hit_alignment_tokens = CHUNK
+    connector._reserve_last_token_for_lookup = False
+    connector._prefix_replay_tokens = 0
+    connector._save_unfull_chunk = False
+    connector._connector_stats = MagicMock()
+    return connector
+
+
+def _store_range(tracker: LMCacheMPRequestTracker) -> tuple[int, int] | None:
+    # Decode chunks count too: the watermark, not the write policy, is tested.
+    meta = LMCacheMPRequestMetadata.GetStoreMetadata(
+        tracker, CHUNK, [CHUNK], save_decode_cache=True
+    )
+    return None if meta is None else (meta.op.start, meta.op.end)
+
+
+@pytest.mark.parametrize("status", [RequestStatus.WAITING, RequestStatus.PREEMPTED])
+@pytest.mark.parametrize("retries", [1, 2, 7])
+def test_retried_lookup_keeps_the_watermark_at_the_hit(
+    status: RequestStatus, retries: int
+) -> None:
+    request = _FakeRequest(list(range(24)), status)
+    connector = _make_connector(_CachedLookupAdapter([8]))
+
+    for _ in range(retries):
+        assert connector.get_num_new_matched_tokens(request, 0) == (8, True)
+
+    tracker = connector.request_trackers[request.request_id]
+    assert tracker.num_stored_tokens == 8
+    assert tracker.num_lmcache_hit_tokens == 8
+
+
+def test_chunks_computed_after_a_retried_lookup_are_stored() -> None:
+    """The consequence that matters: the chunk after the hit is staged for STORE."""
+    request = _FakeRequest(list(range(24)), RequestStatus.PREEMPTED)
+    connector = _make_connector(_CachedLookupAdapter([8]))
+    for _ in range(5):  # four failed allocations, then the one that is admitted
+        connector.get_num_new_matched_tokens(request, 0)
+
+    tracker = connector.request_trackers[request.request_id]
+    tracker.append_block_ids(([10, 11, 12, 13, 14, 15],))
+    tracker.increase_num_scheduled_tokens(8)  # tokens 8..15 are computed in this step
+
+    assert _store_range(tracker) == (8, 16)
+    tracker.increase_num_scheduled_tokens(8)
+    assert _store_range(tracker) == (16, 24)
+
+
+def test_lookup_downgraded_to_zero_on_retry_stores_from_the_start() -> None:
+    """A retry may answer less (a server turned unhealthy): nothing is assumed
+    stored then."""
+    request = _FakeRequest(list(range(24)), RequestStatus.WAITING)
+    connector = _make_connector(_CachedLookupAdapter([8, 0]))
+
+    assert connector.get_num_new_matched_tokens(request, 0) == (8, True)
+    assert connector.get_num_new_matched_tokens(request, 0) == (0, False)
+
+    tracker = connector.request_trackers[request.request_id]
+    assert tracker.num_stored_tokens == 0
+    assert tracker.num_lmcache_hit_tokens == 0
+    tracker.append_block_ids(([10, 11, 12, 13, 14, 15],))
+    tracker.increase_num_scheduled_tokens(24)
+    assert _store_range(tracker) == (0, 24)
+
+
+def test_unfull_chunk_of_a_downgraded_hit_is_not_taken_as_stored() -> None:
+    """The unfull chunk an earlier answer found is withdrawn with it, so the
+    request does not skip storing it."""
+    request = _FakeRequest(list(range(24)), RequestStatus.WAITING)
+    connector = _make_connector(_CachedLookupAdapter([10, 0]))
+    connector._save_unfull_chunk = True
+    connector._unfull_chunk_grid = 2
+
+    assert connector.get_num_new_matched_tokens(request, 0) == (10, True)
+    tracker = connector.request_trackers[request.request_id]
+    assert tracker.unfull_chunk_boundaries == {10}
+    assert connector.get_num_new_matched_tokens(request, 0) == (0, False)
+
+    assert tracker.num_stored_tokens == 0
+    assert tracker.num_lmcache_hit_tokens == 0
+    assert tracker.unfull_chunk_boundaries == set()
+
+
+def test_lmcache_miss_still_counts_the_local_prefix_hit_as_computed() -> None:
+    """With no LMCache hit the GPU prefix hit bounds what is computed, so its
+    chunks are stored at once."""
+    request = _FakeRequest(list(range(24)), RequestStatus.WAITING)
+    connector = _make_connector(_CachedLookupAdapter([0]))
+
+    assert connector.get_num_new_matched_tokens(request, 17) == (0, False)
+
+    tracker = connector.request_trackers[request.request_id]
+    # rounded down to the chunk-aligned boundary
+    assert tracker.num_vllm_hit_tokens == 16
+    tracker.append_block_ids(([10, 11, 12, 13, 14, 15],))
+    tracker.increase_num_scheduled_tokens(1)  # the first step only computes token 17
+    assert _store_range(tracker) == (0, 16)
