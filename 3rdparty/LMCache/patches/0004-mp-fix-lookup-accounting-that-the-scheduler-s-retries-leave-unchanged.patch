 .../integration/vllm/lmcache_mp_metadata.py   |  23 +++
 tests/v1/test_mp_connector_lookup_retry.py    | 144 ++++++++++++++++++
 3 files changed, 183 insertions(+), 10 deletions(-)
 create mode 100644 tests/v1/test_mp_connector_lookup_retry.py

diff --git a/lmcache/integration/vllm/lmcache_mp_connector.py b/lmcache/integration/vllm/lmcache_mp_connector.py
index 5b396b61fcc8613a5ca84542cdbbc940ffa42504..032693b47023ee3a50f0ab057a628179f8346903 100644
--- a/lmcache/integration/vllm/lmcache_mp_connector.py
+++ b/lmcache/integration/vllm/lmcache_mp_connector.py
@@ -1051,6 +1051,7 @@ class LMCacheMPConnector(KVConnectorBase_V1, SupportsHMA):
             self.scheduler_adapter.cleanup_lookup_result(request.request_id)
             tracker.allocated_block_ids.clear()
             tracker.num_stored_tokens = 0
+            tracker._accounted_lookup_tokens = 0
             tracker.num_vllm_hit_tokens = 0
             tracker.num_lmcache_hit_tokens = 0
             tracker.state = LMCacheMPRequestState.BYPASS_LMCACHE
@@ -1067,18 +1068,20 @@ class LMCacheMPConnector(KVConnectorBase_V1, SupportsHMA):
         if ret is None:
             return None, True
 
-        if ret == 0:
-            return 0, False
-
         assert ret % self.scheduler_adapter.lmcache_tokens_per_chunk == 0
 
-        # Update num stored tokens for the tracker
-        tracker.increase_num_stored_tokens(ret)
-
-        # Save the vllm and lmcache hit tokens. The vLLM hit count is
-        # rounded down to a boundary aligned for every engine group (e.g.
-        # a full-prompt APC hit reports ``num_prompt_tokens - 1``), so the
-        # retrieve-skip range stays paged-chunk-aligned in all groups.
+        # This method runs again for a waiting request whose block allocation
+        # failed, with the same cached lookup result, so everything it records
+        # must be idempotent: account the latest result (zero included)
+        # instead of adding the hit on every call.
+        tracker.account_lookup_result(ret)
+
+        # Save the vllm and lmcache hit tokens, also when LMCache misses: the
+        # store upper bound counts computed tokens from the larger of the two.
+        # The vLLM hit count is rounded down to a boundary aligned for every
+        # engine group (e.g. a full-prompt APC hit reports
+        # ``num_prompt_tokens - 1``), so the retrieve-skip range stays
+        # paged-chunk-aligned in all groups.
         tracker.num_vllm_hit_tokens = (
             num_computed_tokens
             // self._hit_alignment_tokens
@@ -1086,6 +1089,9 @@ class LMCacheMPConnector(KVConnectorBase_V1, SupportsHMA):
         )
         tracker.num_lmcache_hit_tokens = ret
 
+        if ret == 0:
+            return 0, False
+
         need_to_load = max(0, ret - num_computed_tokens)
 
         # In full-prompt-hit case, we need to recompute the last token.
diff --git a/lmcache/integration/vllm/lmcache_mp_metadata.py b/lmcache/integration/vllm/lmcache_mp_metadata.py
index c378850023dd798d432af123c11d459cf0aaf0cf..bc2fff416e521e0c048b8a4926054537199b1f07 100644
--- a/lmcache/integration/vllm/lmcache_mp_metadata.py
+++ b/lmcache/integration/vllm/lmcache_mp_metadata.py
@@ -65,6 +65,10 @@ class LMCacheMPRequestTracker:
     # requests.
