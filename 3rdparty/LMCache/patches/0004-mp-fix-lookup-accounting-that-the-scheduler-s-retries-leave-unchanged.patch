+
     # Staging load operation -- save vllm and lmcache hit tokens during lookup
     num_vllm_hit_tokens: int = 0
     num_lmcache_hit_tokens: int = 0
@@ -84,6 +88,7 @@ class LMCacheMPRequestTracker:
         self.all_token_ids = request.all_token_ids
         self.allocated_block_ids = {}
         self.num_stored_tokens = 0
+        self._accounted_lookup_tokens = 0
         self.num_vllm_hit_tokens = 0
         self.num_lmcache_hit_tokens = 0
         self.state = LMCacheMPRequestState.PREFETCHING
@@ -123,6 +128,24 @@ class LMCacheMPRequestTracker:
     def increase_num_scheduled_tokens(self, num_new_tokens: int):
         self.num_scheduled_tokens += num_new_tokens
 
+    def account_lookup_result(self, num_hit_tokens: int) -> None:
+        """Replace the lookup's contribution to the stored-token watermark.
+
+        The scheduler calls ``get_num_new_matched_tokens`` again for a waiting
+        request whose block allocation failed, and the adapter then returns the
+        same cached lookup result (or a changed one, including a downgrade to
+        zero). Only the difference from the previously accounted result is
+        applied, so the watermark stays at the hit however often the scheduler
+        retries; adding the hit on every call pushed it past the request's
+        length and no later chunk of the request was ever stored
+        (LMCache issue #4508, PR #4520).
+
+        Args:
+            num_hit_tokens: Prefix token count of the latest completed lookup.
+        """
+        self.num_stored_tokens += num_hit_tokens - self._accounted_lookup_tokens
+        self._accounted_lookup_tokens = num_hit_tokens
+
     def increase_num_stored_tokens(self, num_new_tokens: int):
         """Increase the number of stored tokens for the current request
         This function will be called when processing the cached requests.
diff --git a/tests/v1/test_mp_connector_lookup_retry.py b/tests/v1/test_mp_connector_lookup_retry.py
new file mode 100644
index 0000000000000000000000000000000000000000..f4dabb13b73aa3e6d53cb345685548a692282d90
--- /dev/null
+++ b/tests/v1/test_mp_connector_lookup_retry.py
@@ -0,0 +1,144 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Scheduler retries of ``get_num_new_matched_tokens`` must not move the store watermark.
+
+vLLM asks the connector again for a waiting request whose block allocation
+failed; the adapter returns the same cached lookup result until
+``update_state_after_alloc`` cleans it up. Adding the hit on every call put
+``num_stored_tokens`` past the request's length, so the request never stored
+another chunk (LMCache issue #4508): under GPU memory pressure every resumed
+or queued request lost what it computed.
+"""
+
+# Standard
+from typing import Any
+
+# Third Party
+import pytest
+
+pytest.importorskip("vllm", reason="MP connector imports vLLM at module top")
+
+# Third Party
+from vllm.v1.request import RequestStatus  # noqa: E402
+from vllm.v1.utils import ConstantList  # noqa: E402
+
+# First Party
+from lmcache.integration.vllm.lmcache_mp_connector import (  # noqa: E402
+    LMCacheMPConnector,
+)
+from lmcache.integration.vllm.lmcache_mp_metadata import (  # noqa: E402
+    LMCacheMPRequestMetadata,
+    LMCacheMPRequestTracker,
+)
+
+CHUNK = 4
+
+
+class _FakeRequest:
+    def __init__(self, token_ids: list[int], status: RequestStatus) -> None:
+        self.request_id = "req-0"
+        self.cache_salt = ""
+        self.prompt_token_ids = list(token_ids[:4])
+        self._token_ids = list(token_ids)
+        self.all_token_ids = ConstantList(self._token_ids)
+        self.mm_features = []
+        self.status = status
+        self.num_computed_tokens = 0
+
+
+class _CachedLookupAdapter:
+    """Returns one finished lookup result until it is cleaned up, as the real adapter does."""
+
+    lmcache_tokens_per_chunk = CHUNK
+
+    def __init__(self, results: list[int | None]) -> None:
+        self._results = list(results)
+        self.submitted = 0
+
+    def maybe_submit_lookup_request(
+        self,
+        request_id: str,
+        token_ids: list[int],
+        cache_salt: str,
+        request_configs: dict[str, Any] | None = None,
+    ) -> None:
+        del request_id, token_ids, cache_salt, request_configs
+        self.submitted += 1
+
+    def check_lookup_result(self, request_id: str) -> int | None:
+        del request_id
+        return self._results.pop(0) if len(self._results) > 1 else self._results[0]
+
+
+def _make_connector(adapter: _CachedLookupAdapter) -> LMCacheMPConnector:
+    connector = object.__new__(LMCacheMPConnector)
+    connector.request_trackers = {}
+    connector.scheduler_adapter = adapter
+    connector._hit_alignment_tokens = CHUNK
+    return connector
+
+
+def _store_range(tracker: LMCacheMPRequestTracker) -> tuple[int, int] | None:
+    meta = LMCacheMPRequestMetadata.GetStoreMetadata(tracker, CHUNK, [CHUNK])
+    return None if meta is None else (meta.op.start, meta.op.end)
+
+
+@pytest.mark.parametrize("status", [RequestStatus.WAITING, RequestStatus.PREEMPTED])
+@pytest.mark.parametrize("retries", [1, 2, 7])
+def test_retried_lookup_keeps_the_watermark_at_the_hit(
+    status: RequestStatus, retries: int
+) -> None:
+    request = _FakeRequest(list(range(24)), status)
+    connector = _make_connector(_CachedLookupAdapter([8]))
+
+    for _ in range(retries):
+        assert connector.get_num_new_matched_tokens(request, 0) == (8, True)
+
+    tracker = connector.request_trackers[request.request_id]
+    assert tracker.num_stored_tokens == 8
+    assert tracker.num_lmcache_hit_tokens == 8
+
+
+def test_chunks_computed_after_a_retried_lookup_are_stored() -> None:
+    """The consequence that matters: the chunk right after the hit is staged for STORE."""
+    request = _FakeRequest(list(range(24)), RequestStatus.PREEMPTED)
+    connector = _make_connector(_CachedLookupAdapter([8]))
+    for _ in range(5):  # four failed allocations, then the one that is admitted
+        connector.get_num_new_matched_tokens(request, 0)
+
+    tracker = connector.request_trackers[request.request_id]
+    tracker.append_block_ids(([10, 11, 12, 13, 14, 15],))
+    tracker.increase_num_scheduled_tokens(8)  # tokens 8..15 are computed in this step
+
+    assert _store_range(tracker) == (8, 16)
+    tracker.increase_num_scheduled_tokens(8)
+    assert _store_range(tracker) == (16, 24)
+
+
+def test_lookup_downgraded_to_zero_on_retry_stores_from_the_start() -> None:
+    """A retry may return less (the server turned unhealthy): nothing is assumed stored then."""
+    request = _FakeRequest(list(range(24)), RequestStatus.WAITING)
+    connector = _make_connector(_CachedLookupAdapter([8, 0]))
+
+    assert connector.get_num_new_matched_tokens(request, 0) == (8, True)
+    assert connector.get_num_new_matched_tokens(request, 0) == (0, False)
+
+    tracker = connector.request_trackers[request.request_id]
+    assert tracker.num_stored_tokens == 0
+    assert tracker.num_lmcache_hit_tokens == 0
+    tracker.append_block_ids(([10, 11, 12, 13, 14, 15],))
+    tracker.increase_num_scheduled_tokens(24)
+    assert _store_range(tracker) == (0, 24)
+
+
+def test_lmcache_miss_still_counts_the_local_prefix_hit_as_computed() -> None:
+    """With no LMCache hit the GPU prefix hit bounds what is computed, so its chunks are stored at once."""
+    request = _FakeRequest(list(range(24)), RequestStatus.WAITING)
+    connector = _make_connector(_CachedLookupAdapter([0]))
+
+    assert connector.get_num_new_matched_tokens(request, 17) == (0, False)
+
+    tracker = connector.request_trackers[request.request_id]
+    assert tracker.num_vllm_hit_tokens == 16  # rounded down to the chunk-aligned boundary
+    tracker.append_block_ids(([10, 11, 12, 13, 14, 15],))
+    tracker.increase_num_scheduled_tokens(1)  # the first step only computes token 17
+    assert _store_range(tracker) == (0, 16)
