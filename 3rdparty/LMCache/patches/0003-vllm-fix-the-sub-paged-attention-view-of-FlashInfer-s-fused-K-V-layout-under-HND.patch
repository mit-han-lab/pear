@@ -573,6 +580,44 @@ class _SubpagedAttentionViewEdit(KVCacheGroupEdit):
             int(spec.page_size_bytes),
         )
 
+    @staticmethod
+    def _apply_fused(spec: KVCacheSpec, kv_cache: torch.Tensor) -> torch.Tensor:
+        """Re-view the contiguous HND tensor ``(num_kernel_pages, num_kv_heads,
+        kernel_block_size, 2 * head_size)`` of vLLM's FlashInfer backend as
+        ``(num_blocks, 1, spec.block_size, num_kv_heads * 2 * head_size)``,
+        whose HND reading finds the block size on its token axis."""
+        # The NHD-shaped rank-5 view's HND reading takes the block size from its
+        # synthetic heads axis. With one KV head per rank the dims stay semantic;
+        # with more, token rows interleave heads but whole blocks round-trip.
+        num_kernel_pages, num_heads, kernel_block_size, content_size = kv_cache.shape
+        logical_block_size = spec.block_size
+        if logical_block_size % kernel_block_size != 0:
+            raise ValueError(
+                f"logical block size {logical_block_size} is not a multiple of "
+                f"kernel block size {kernel_block_size}"
+            )
+        ratio = logical_block_size // kernel_block_size
+        if num_kernel_pages % ratio != 0:
+            raise ValueError(
+                f"kernel page count {num_kernel_pages} is not a multiple of "
+                f"the logical/kernel block ratio {ratio}"
+            )
+        kernel_page_bytes = kv_cache.shape[1:].numel() * kv_cache.element_size()
+        if kernel_page_bytes * ratio != spec.page_size_bytes:
+            raise ValueError(
+                f"{ratio} kernel pages ({kernel_page_bytes * ratio} bytes) do "
+                f"not tile the logical page ({spec.page_size_bytes} bytes)"
+            )
+        if not kv_cache.is_contiguous():
+            raise ValueError(
+                f"fused K/V tensor with strides {tuple(kv_cache.stride())} is "
+                "not HND-contiguous; cannot re-view as logical pages"
+            )
+        num_blocks = num_kernel_pages // ratio
+        return kv_cache.view(
+            num_blocks, 1, logical_block_size, num_heads * content_size
+        )
+
 
