+# --------------------------------------------------------------------------
+# HND: what vLLM's FlashInfer backend requires on Blackwell
+# --------------------------------------------------------------------------
+
+# vLLM's layout hints under HND
+HND = {"kv_layout": "HND"}
+
+
+def test_subpaged_edit_keeps_hnd_fused_kv_at_rank_4(edits):
+    """Under HND the contiguous fused rank-4 tensor is re-viewed over the same
+    storage with one logical block per page."""
+    cache = _fused_kv_cache()
+    viewed_cache = _edit_attention(edits, cache, layout_hints=HND)
+
+    assert tuple(viewed_cache.shape) == (
+        NUM_LOGICAL_BLOCKS,
+        1,
+        LOGICAL_BLOCK_SIZE,
+        NUM_KV_HEADS * 2 * HEAD_SIZE,
+    )
+    assert (
+        viewed_cache.untyped_storage().data_ptr() == cache.untyped_storage().data_ptr()
+    )
+    for block in range(NUM_LOGICAL_BLOCKS):
+        expected_block = cache[block * SUBPAGE_RATIO : (block + 1) * SUBPAGE_RATIO]
+        torch.testing.assert_close(
+            viewed_cache[block].reshape(-1), expected_block.reshape(-1)
+        )
+
+
+def test_hnd_fused_edit_reads_at_the_scheduler_block_size(edits):
+    """The HND reading of the edited view finds the scheduler block size, where
+    that of an NHD-shaped rank-5 view finds the synthetic heads axis (1)."""
+    # First Party
+    from lmcache.utils import EngineType
+    from lmcache.v1.common.kv_format import detect_format
+    from lmcache.v1.common.utils import get_block_size
+    import lmcache.lmcache_native as lmcache_native
+
+    viewed_cache = _edit_attention(edits, _fused_kv_cache(), layout_hints=HND)
+    engine_kv_format, normalized_caches = detect_format(
+        [viewed_cache], EngineType.VLLM, HND
+    )
+
+    assert engine_kv_format == lmcache_native.EngineKVFormat.NL_X_NB_NH_BS_CS
+    assert get_block_size(normalized_caches, engine_kv_format) == LOGICAL_BLOCK_SIZE
+
+
+def test_subpaged_edit_rejects_non_contiguous_hnd_fused_kv(edits):
+    """An HND fused tensor that is not contiguous (e.g. a cross-layer view)
+    fails loudly rather than being re-viewed in the wrong order."""
+    physical_cache = torch.zeros(
+        NUM_KERNEL_PAGES,
+        KERNEL_BLOCK_SIZE,
+        NUM_KV_HEADS,
+        2 * HEAD_SIZE,
+        dtype=torch.bfloat16,
+    )
+    registered_cache = physical_cache.permute(0, 2, 1, 3)
+
+    with pytest.raises(ValueError, match="not HND-contiguous"):
+        _edit_attention(edits, registered_cache, layout_hints=HND)
+
+
 def test_subpaged_edit_rejects_untiled_page(edits):
     """An undeclared packed layout must fail loudly, not transfer wrongly."""
     spec = _attention_spec()
