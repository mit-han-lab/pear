diff --git a/tests/v1/test_mp_store_current_block_table.py b/tests/v1/test_mp_store_current_block_table.py
new file mode 100644
index 0000000000000000000000000000000000000000..3bb47bd09aa87f7841f98442a43824ce24231872
--- /dev/null
+++ b/tests/v1/test_mp_store_current_block_table.py
@@ -0,0 +1,219 @@
+# SPDX-License-Identifier: Apache-2.0
+# Standard
+from types import SimpleNamespace
+
+# Third Party
+import pytest
+
+pytest.importorskip("vllm", reason="MP connector imports vLLM at module top")
+
+# Third Party
+from vllm.v1.core.block_pool import BlockPool  # noqa: E402
+from vllm.v1.core.sched.output import KVConnectorBlockState  # noqa: E402
+from vllm.v1.core.single_type_kv_cache_manager import (  # noqa: E402
+    FullAttentionManager,
+    MambaManager,
+)
+from vllm.v1.kv_cache_interface import FullAttentionSpec, MambaSpec  # noqa: E402
+from vllm.v1.utils import ConstantList  # noqa: E402
+import torch  # noqa: E402
+
+# First Party
+from lmcache.integration.vllm.lmcache_mp_connector import (  # noqa: E402
+    LMCacheMPConnector,
+)
+from lmcache.integration.vllm.lmcache_mp_metadata import (  # noqa: E402
+    LMCacheMPConnectorMetadata,
+    LMCacheMPRequestTracker,
+)
+
+# Tokens per block in both groups, and per LMCache chunk.
+BLOCK = 16
+# Align-mode Mamba keeps one scratch block per draft token (MTP, 3 drafts).
+NUM_SPECULATIVE_BLOCKS = 3
+# Engine groups in vLLM's order for a model whose first layer is linear
+# attention: the Mamba group allocates first.
+MAMBA, ATTENTION = 0, 1
+# Room for both requests' blocks.
+NUM_GPU_BLOCKS = 64
+# The decoding request's prompt ends inside its second block, so its decode
+# crosses token 32.
+PROMPT = 30
+
+
+class _Engine:
+    """vLLM's block pool shared by an align-mode Mamba group and an attention
+    group, allocated per request as ``KVCacheManager.allocate_slots`` does."""
+
+    def __init__(self) -> None:
+        self.pool = BlockPool(
+            num_gpu_blocks=NUM_GPU_BLOCKS, enable_caching=True, hash_block_size=BLOCK
+        )
+        mamba_spec = MambaSpec(
+            block_size=BLOCK,
+            shapes=((1, 1),),
+            dtypes=(torch.float32,),
+            mamba_cache_mode="align",
+            num_speculative_blocks=NUM_SPECULATIVE_BLOCKS,
+        )
+        attention_spec = FullAttentionSpec(
+            block_size=BLOCK, num_kv_heads=1, head_size=1, dtype=torch.float32
+        )
+        self.managers = (
+            MambaManager(
+                mamba_spec,
+                block_pool=self.pool,
+                enable_caching=True,
+                kv_cache_group_id=MAMBA,
+                scheduler_block_size=BLOCK,
+            ),
+            FullAttentionManager(
+                attention_spec,
+                block_pool=self.pool,
+                enable_caching=True,
+                kv_cache_group_id=ATTENTION,
+                scheduler_block_size=BLOCK,
+            ),
+        )
+
+    def schedule(
+        self, request_id: str, num_processed_tokens: int, num_tokens: int
+    ) -> tuple[list[int], ...]:
+        """Run one step's allocation of a request; return the block IDs vLLM
+        reports for it."""
+        for manager in self.managers:
+            manager.remove_skipped_blocks(request_id, num_processed_tokens)
+        return tuple(
+            [
+                block.block_id
+                for block in manager.allocate_new_blocks(
+                    request_id, num_tokens, num_tokens
+                )
+            ]
+            for manager in self.managers
+        )
+
+    def block_table(self, request_id: str) -> tuple[list[int], ...]:
+        """The request's current block IDs, as ``KVCacheManager.get_block_ids``."""
+        return tuple(
+            [block.block_id for block in manager.req_to_blocks[request_id]]
+            for manager in self.managers
+        )
+
+
+def test_store_skips_a_mamba_state_block_vllm_gave_to_another_request():
+    """The STORE of a decoding request's chunk [16, 32), built in the step in
+    which vLLM gave that chunk's freed Mamba state block to a prefilling
+    request as a speculative block, neither pins nor reads the block, which
+    vLLM relocates only while no one else references it."""
+    engine = _Engine()
+    decode_tracker = _tracker(
+        "decode", num_tokens=PROMPT + 1 + NUM_SPECULATIVE_BLOCKS + 1
+    )
+
+    # Step 1: the decoding request prefills its prompt, the prefilling one its
+    # first block. LMCache stores the decoding request's chunk [0, 16).
+    decode_tracker.append_block_ids(
+        engine.schedule("decode", 0, PROMPT), NUM_SPECULATIVE_BLOCKS
+    )
+    decode_tracker.increase_num_stored_tokens(BLOCK)
+    engine.schedule("prefill", 0, BLOCK)
+    state_block_id = engine.block_table("decode")[MAMBA][1]
+
+    # Step 2: the decoding request verifies 3 drafts after its sampled token,
+    # all accepted, which moves its running Mamba state past block 1.
+    num_tokens = PROMPT + 1 + NUM_SPECULATIVE_BLOCKS
+    decode_tracker.append_block_ids(
+        engine.schedule("decode", PROMPT, num_tokens), NUM_SPECULATIVE_BLOCKS
+    )
+
+    # Step 3: vLLM frees the block, and the prefilling request's next chunk
+    # takes it as its newest speculative block; LMCache's tracker still lists it.
+    engine.schedule("decode", num_tokens, num_tokens + 1 + NUM_SPECULATIVE_BLOCKS)
+    engine.schedule("prefill", BLOCK, 2 * BLOCK)
+    assert engine.block_table("prefill")[MAMBA][-1] == state_block_id
+    assert decode_tracker.allocated_block_ids[MAMBA][1] == state_block_id
+
+    connector = _connector(engine.pool, decode_tracker)
+    metadata = LMCacheMPConnectorMetadata()
+    connector._process_cached_requests(
+        _scheduler_output(engine, "decode", num_tokens), metadata
+    )
+
+    (store,) = metadata.requests
+    assert (store.op.start, store.op.end) == (BLOCK, 2 * BLOCK)
+    assert store.op.block_ids == [
+        [engine.pool.null_block.block_id],
+        [engine.block_table("decode")[ATTENTION][1]],
+    ]
+    assert engine.pool.blocks[state_block_id].ref_cnt == 1
+
+    # Step 4: the prefilling request's next chunk spans five blocks, so vLLM
+    # relocates its speculative blocks, this one included.
+    engine.schedule("prefill", 2 * BLOCK, 7 * BLOCK)
+    prefill_mamba_blocks = engine.block_table("prefill")[MAMBA]
+    assert state_block_id in prefill_mamba_blocks[-NUM_SPECULATIVE_BLOCKS:]
+
+
+def test_store_without_vllms_table_for_its_request_is_refused():
+    block_state = KVConnectorBlockState(
+        req_ids=set(),
+        resolve_block_ids=lambda request_id: ([], []),
+        boundary_state_offloads={},
+    )
+
+    with pytest.raises(RuntimeError, match="no block table for request decode"):
+        _tracker("decode", num_tokens=PROMPT).current_block_ids(block_state)
+
+
+def _tracker(request_id: str, num_tokens: int) -> LMCacheMPRequestTracker:
+    """A request of ``PROMPT`` prompt tokens with ``num_tokens`` tokens known."""
+    request = SimpleNamespace(
+        request_id=request_id,
+        cache_salt="",
+        lora_request=None,
+        prompt_token_ids=list(range(PROMPT)),
+        all_token_ids=ConstantList(list(range(num_tokens))),
+        num_prompt_tokens=PROMPT,
+        mm_features=[],
+        sampling_params=SimpleNamespace(extra_args=None, max_tokens=8 * BLOCK),
+    )
+    return LMCacheMPRequestTracker(request)
+
+
+def _connector(pool: BlockPool, tracker: LMCacheMPRequestTracker) -> LMCacheMPConnector:
+    """A scheduler connector that stores decode chunks and pins in ``pool``."""
+    connector = object.__new__(LMCacheMPConnector)
+    connector.scheduler_adapter = SimpleNamespace(lmcache_tokens_per_chunk=BLOCK)
+    connector.request_trackers = {tracker.request_id: tracker}
+    connector._mamba_relocation_window = NUM_SPECULATIVE_BLOCKS
+    connector._group_tokens_per_block = [BLOCK, BLOCK]
+    connector._can_store = True
+    connector._save_decode_cache = True
+    connector._save_unfull_chunk = False
+    connector.lazy_offload = False
+    connector._gpu_block_pool = pool
+    connector._next_store_op_id = 0
+    connector._pinned_store_operations = {}
+    return connector
+
+
+def _scheduler_output(
+    engine: _Engine, request_id: str, num_computed_tokens: int
+) -> SimpleNamespace:
+    """The scheduler output of a step that schedules one draft-verifying
+    decode of ``request_id`` and allocates it no new block."""
+    return SimpleNamespace(
+        scheduled_cached_reqs=SimpleNamespace(
+            req_ids=[request_id],
+            new_block_ids=[None],
+            num_computed_tokens=[num_computed_tokens],
+            resumed_req_ids=set(),
+        ),
+        num_scheduled_tokens={request_id: 1 + NUM_SPECULATIVE_BLOCKS},
+        kv_connector_block_state=KVConnectorBlockState(
+            req_ids={request_id},
+            resolve_block_ids=engine.block_table,
+            boundary_state_offloads={},
+        ),
+    )
