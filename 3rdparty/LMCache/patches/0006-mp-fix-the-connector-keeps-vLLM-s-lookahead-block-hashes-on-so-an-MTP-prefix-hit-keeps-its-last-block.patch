diff --git a/lmcache/integration/vllm/lmcache_mp_connector.py b/lmcache/integration/vllm/lmcache_mp_connector.py
index 776f6f6bb3d84aec705a95acc686da31c0f5750a..6614bc3cbe59a680ae4b4da56b0633ed8904bc92 100644
--- a/lmcache/integration/vllm/lmcache_mp_connector.py
+++ b/lmcache/integration/vllm/lmcache_mp_connector.py
@@ -830,6 +830,16 @@ class LMCacheMPConnector(KVConnectorBase_V1, SupportsHMA):
         self.lazy_offload = vllm_config.kv_transfer_config.get_from_extra_config(
             "lmcache.mp.lazy_offload", False
         )
+        # Lazy offload snapshots each block's vLLM hash when a store is
+        # offered and drops the store if the hash is missing or changes later.
+        # With lookahead block hashes (supports_lookahead_block_hashes) vLLM
+        # hashes a block only once the tokens after it exist, so a store holds
+        # those back. vLLM releases before lookahead hashing lack the field.
+        self._store_lookahead_tokens: int = (
+            getattr(vllm_config, "num_hash_lookahead_tokens", 0)
+            if self.lazy_offload
+            else 0
+        )
         if self.lazy_offload and self._save_unfull_chunk:
             raise ValueError(
                 "lmcache.mp.save_unfull_chunk does not support lmcache.mp.lazy_offload"
@@ -1940,6 +1950,30 @@ class LMCacheMPConnector(KVConnectorBase_V1, SupportsHMA):
             return self._lazy_offload_manager.has_inflight_store_work()
         return bool(self._pinned_store_operations)
 
+    @classmethod
+    def supports_lookahead_block_hashes(
+        cls, kv_transfer_config: "KVTransferConfig"
+    ) -> bool:
+        """Keep vLLM's lookahead block hashes on for EAGLE / MTP.
+
+        An EAGLE / MTP drafter computes the draft KV at a block's last position
+        from the token after the block. vLLM folds that token into its block
+        hashes only for a connector that supports it; for any other (vLLM
+        0.34's default) it drops the last matched block of every local
+        prefix-cache hit and moves the Mamba checkpoints of align mode back
+        with it. Stores and retrieves here follow the request's tokens, never
+        vLLM's block hashes, and LMCache's chunk keys stay token-only, so spec
+        and non-spec engines keep sharing KV.
+
+        Args:
+            kv_transfer_config: The connector's transfer config (unused; the
+                support does not depend on it).
+
+        Returns:
+            Always True.
+        """
+        return True
+
     @classmethod
     def get_required_kvcache_layout(cls, vllm_config: "VllmConfig") -> str | None:
         """Defer to vLLM; a connector preference is unsafe for now.
@@ -2074,6 +2108,7 @@ class LMCacheMPConnector(KVConnectorBase_V1, SupportsHMA):
                 self._group_tokens_per_block,
                 save_decode_cache=self._save_decode_cache,
                 block_state=block_state,
+                lookahead_tokens=self._store_lookahead_tokens,
             )
             if r_meta is not None:
                 # In lazy_offload mode, add to pending queue instead of immediate store
@@ -2126,6 +2161,7 @@ class LMCacheMPConnector(KVConnectorBase_V1, SupportsHMA):
                 self._group_tokens_per_block,
                 save_decode_cache=self._save_decode_cache,
                 block_state=block_state,
+                lookahead_tokens=self._store_lookahead_tokens,
             )
 
             if r_meta is not None:
