diff --git a/tests/v1/test_mp_connector_lookahead_opt_in.py b/tests/v1/test_mp_connector_lookahead_opt_in.py
new file mode 100644
index 0000000000000000000000000000000000000000..c5ef59e33ddabd5fbe2564e2a3cc206b4d222efc
--- /dev/null
+++ b/tests/v1/test_mp_connector_lookahead_opt_in.py
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: Apache-2.0
+"""The MP connector keeps vLLM's lookahead block hashes on under EAGLE / MTP."""
+
+# Standard
+from types import SimpleNamespace
+
+# Third Party
+import pytest
+
+MODULE = "lmcache.integration.vllm.lmcache_mp_connector"
+# An MTP drafter computes a block's last draft KV from the one token after it.
+DRAFTER_LOOKAHEAD_TOKENS = 1
+
+
+@pytest.fixture
+def connector_cls():
+    """Import lazily: the connector module initializes process-wide MP
+    transfer state at import time, which contaminates later cache-server
+    tests when imported at collection. Skips where vLLM is not installed
+    (e.g. the LMCache-only unit environment)."""
+    module = pytest.importorskip(MODULE, reason="requires vLLM")
+    return module.LMCacheMPConnector
+
+
+def make_transfer_config():
+    # Third Party
+    from vllm.config import KVTransferConfig
+
+    return KVTransferConfig(
+        kv_connector="LMCacheMPConnector",
+        kv_connector_module_path=MODULE,
+        kv_role="kv_both",
+    )
+
+
+def test_connector_supports_lookahead_block_hashes(connector_cls):
+    assert connector_cls.supports_lookahead_block_hashes(make_transfer_config())
+
+
+def test_vllm_keeps_lookahead_block_hashes_with_the_connector(connector_cls):
+    """vLLM resolves its hash lookahead through the configured connector
+    class: 0 for a connector without the opt-in, which makes every local
+    prefix-cache hit drop its last block under EAGLE / MTP."""
+    # Third Party
+    from vllm.config import VllmConfig
+
+    resolve = getattr(VllmConfig, "_resolve_num_hash_lookahead_tokens", None)
+    if resolve is None:
+        pytest.skip("this vLLM has no lookahead block hashes")
+    config = SimpleNamespace(
+        speculative_config=SimpleNamespace(
+            use_eagle_block_drop=lambda: True,
+            disable_lookahead_block_hashes=False,
+        ),
+        kv_transfer_config=make_transfer_config(),
+        cache_config=SimpleNamespace(enable_prefix_caching=True),
+        num_prefill_lookahead_tokens=DRAFTER_LOOKAHEAD_TOKENS,
+    )
+
+    assert resolve(config) == DRAFTER_LOOKAHEAD_TOKENS
diff --git a/tests/v1/test_mp_store_current_block_table.py b/tests/v1/test_mp_store_current_block_table.py
index 3bb47bd09aa87f7841f98442a43824ce24231872..feae1c90ccafbe7568fe613101ee17cba29cad2c 100644
--- a/tests/v1/test_mp_store_current_block_table.py
+++ b/tests/v1/test_mp_store_current_block_table.py
@@ -192,6 +192,7 @@ def _connector(pool: BlockPool, tracker: LMCacheMPRequestTracker) -> LMCacheMPCo
     connector._save_decode_cache = True
     connector._save_unfull_chunk = False
     connector.lazy_offload = False
+    connector._store_lookahead_tokens = 0
     connector._gpu_block_pool = pool
     connector._next_store_op_id = 0
     connector._pinned_store_operations = {}
diff --git a/tests/v1/test_mp_tracker_store_bound.py b/tests/v1/test_mp_tracker_store_bound.py
index 77e1dccc9b249d663c375f9e353f212c6a2cf48b..39e3c3fe46d604d309302b588477083c22943e5c 100644
--- a/tests/v1/test_mp_tracker_store_bound.py
+++ b/tests/v1/test_mp_tracker_store_bound.py
@@ -93,3 +93,35 @@ def test_without_engine_position_falls_back_to_hits():
     _lookup(tracker, vllm_hit=112, lmcache_hit=64)
     tracker.increase_num_scheduled_tokens(188)
     assert _store_range(tracker) == (64, 192)
+
+
+@pytest.mark.parametrize(
+    ("lookahead_tokens", "stored_range"), [(0, (0, 256)), (1, (0, 192))]
+)
+def test_lookahead_holds_back_a_chunk_until_its_next_token_exists(
+    lookahead_tokens, stored_range
+):
+    """Lazy offload needs vLLM's hash of every stored block, which a lookahead
+    hash has only once the tokens after the block exist: a chunk-aligned
+    prompt's last chunk waits for the first generated token."""
+    request = SimpleNamespace(
+        request_id="req-lookahead",
+        cache_salt="",
+        lora_request=None,
+        prompt_token_ids=list(range(256)),
+        all_token_ids=ConstantList(list(range(256))),
+        num_prompt_tokens=256,
+        mm_features=[],
+        sampling_params=SimpleNamespace(extra_args=None, max_tokens=16),
+    )
+    tracker = LMCacheMPRequestTracker(request)
+    tracker.append_block_ids((list(range(1, 5)), list(range(101, 117))))
+    tracker.increase_num_scheduled_tokens(256)
+    tracker.update_num_engine_computed_tokens(0, 256)
+
+    meta = LMCacheMPRequestMetadata.GetStoreMetadata(
+        tracker, CHUNK, GROUP_TOKENS_PER_BLOCK, lookahead_tokens=lookahead_tokens
+    )
+
+    assert meta is not None
+    assert (meta.op.start, meta.op.end) == stored_range
