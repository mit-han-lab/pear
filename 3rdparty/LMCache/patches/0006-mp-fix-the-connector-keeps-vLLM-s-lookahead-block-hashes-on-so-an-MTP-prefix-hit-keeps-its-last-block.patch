 .../integration/vllm/lmcache_mp_metadata.py   |  7 ++-
 tests/v1/lazy_offload/test_mp_connector.py    |  1 +
 .../v1/test_mp_connector_lookahead_opt_in.py  | 60 +++++++++++++++++++
 tests/v1/test_mp_store_current_block_table.py |  1 +
 tests/v1/test_mp_tracker_store_bound.py       | 32 ++++++++++
 6 files changed, 136 insertions(+), 1 deletion(-)
