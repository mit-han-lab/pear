             got = (
                 tuple(kv_cache.shape)
@@ -334,7 +351,9 @@ class _SubpagedAttentionViewEdit(KVCacheGroupEdit):
                 f"attention KV tensor, got {got}"
             )
         logical_block_size = spec.block_size
-        kernel_block_size = kv_cache.shape[2]
+        # HND keeps the token dim after the heads; NHD (the default) before them
+        block_dim = 3 if layout_hints.get("kv_layout") == "HND" else 2
+        kernel_block_size = kv_cache.shape[block_dim]
         if logical_block_size % kernel_block_size != 0:
             raise ValueError(
                 f"logical block size {logical_block_size} is not a multiple of "
@@ -367,6 +386,53 @@ class _SubpagedAttentionViewEdit(KVCacheGroupEdit):
         )
         return kv_cache.view(num_blocks, 2, logical_block_size, num_heads, head_size)
 
+    @staticmethod
+    def _apply_fused(spec: KVCacheSpec, kv_cache: torch.Tensor) -> torch.Tensor:
+        """Re-view a fused-K/V kernel-paged tensor at logical-block granularity.
+
+        vLLM's FlashInfer backend registers ``(num_kernel_pages, num_kv_heads,
+        kernel_block_size, 2 * head_size)``: the logical shape is the same in
+        both layouts, HND memory is that shape contiguous and NHD memory is
+        ``(pages, block, heads, content)`` behind a permuted view. The result
+        keeps the layout's memory order and has ``spec.block_size`` tokens per
+        page: ``(num_blocks, 1, block_size, num_kv_heads * content)`` for HND,
+        the NHD-strided equivalent otherwise. With one KV head per rank the
+        dims stay semantic; with more heads the token rows interleave heads at
+        kernel-page granularity, which round-trips but is not content-aware
+        (the same caveat as the 5-D re-view above).
+        """
+        num_kernel_pages, num_heads, kernel_block_size, content = kv_cache.shape
+        logical_block_size = spec.block_size
+        if logical_block_size % kernel_block_size != 0:
+            raise ValueError(
+                f"logical block size {logical_block_size} is not a multiple of "
+                f"kernel block size {kernel_block_size}"
+            )
+        ratio = logical_block_size // kernel_block_size
+        if num_kernel_pages % ratio != 0:
+            raise ValueError(
+                f"kernel page count {num_kernel_pages} is not a multiple of "
+                f"the logical/kernel block ratio {ratio}"
+            )
+        kernel_page_bytes = kv_cache.shape[1:].numel() * kv_cache.element_size()
+        if kernel_page_bytes * ratio != spec.page_size_bytes:
+            raise ValueError(
+                f"{ratio} kernel pages ({kernel_page_bytes * ratio} bytes) do "
+                f"not tile the logical page ({spec.page_size_bytes} bytes)"
+            )
+        num_blocks = num_kernel_pages // ratio
+        if kv_cache.is_contiguous():  # HND memory: (pages, heads, block, content)
+            return kv_cache.view(num_blocks, 1, logical_block_size, num_heads * content)
+        nhd = kv_cache.permute(0, 2, 1, 3)  # NHD memory: (pages, block, heads, content)
+        if not nhd.is_contiguous():
+            raise ValueError(
+                f"fused K/V tensor with strides {tuple(kv_cache.stride())} is "
+                "neither HND- nor NHD-contiguous; cannot re-view as logical pages"
+            )
+        return nhd.view(num_blocks, logical_block_size, 1, num_heads * content).permute(
+            0, 2, 1, 3
+        )
+
 
