             and not _declares_slot_compression(spec)
-            # (num_blocks, 2, block_size, num_heads, head_size) layout whose
-            # block dim disagrees with the scheduler block-id unit -- the
-            # backend re-paged the tensor at its kernel block size.
+            # (num_blocks, 2, block_size, num_heads, head_size) (NHD) or
+            # (num_blocks, 2, num_heads, block_size, head_size) (HND) layout
+            # whose block dim disagrees with the scheduler block-id unit -- the
+            # backend re-paged the tensor at its kernel block size. The layout
+            # is not known here, so both candidate dims are checked.
             and isinstance(kv_cache, torch.Tensor)
-            and kv_cache.ndim == 5
-            and kv_cache.shape[2] != spec.block_size
+            and (
+                (
+                    kv_cache.ndim == 5
+                    and kv_cache.shape[2] != spec.block_size
+                    and kv_cache.shape[3] != spec.block_size
+                )
+                # Fused K/V (FlashInfer): logical (num_blocks, num_heads,
+                # block_size, 2 * head_size) in both layouts, so the token
+                # axis is always dim 2 and only its size has to disagree.
+                or (kv_cache.ndim == 4 and kv_cache.shape[2] != spec.block_size)
+            )
         )
 
