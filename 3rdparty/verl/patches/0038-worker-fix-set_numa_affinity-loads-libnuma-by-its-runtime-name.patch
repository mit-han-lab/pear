From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pear <pear@localhost>
Date: Mon, 17 Sep 2001 00:00:00 +0000
Subject: [PATCH] [worker] fix: set_numa_affinity loads libnuma by its runtime
 name

set_numa_affinity loaded libnuma.so, the link of libnuma's development package. On a machine with the
runtime library alone the load failed, the function printed a warning and every training worker ran
without its GPU's CPU affinity. It now loads libnuma.so.1, the name the runtime library itself has.
---
 tests/utils/test_numa_affinity_on_cpu.py | 33 ++++++++++++++++++++++++
 verl/utils/distributed.py                |  3 ++-
 2 files changed, 35 insertions(+), 1 deletion(-)
 create mode 100644 tests/utils/test_numa_affinity_on_cpu.py

diff --git a/tests/utils/test_numa_affinity_on_cpu.py b/tests/utils/test_numa_affinity_on_cpu.py
new file mode 100644
index 0000000000000000000000000000000000000000..9b340f7ef40ca829907c78311ae12b0c8563da92
--- /dev/null
+++ b/tests/utils/test_numa_affinity_on_cpu.py
@@ -0,0 +1,33 @@
+import sys
+from types import SimpleNamespace
+
+from verl.utils import distributed
+
+RUNTIME_LIBRARY = "libnuma.so.1"  # libnuma's own name; libnuma.so is the link of its development package
+
+
+def test_numa_affinity_is_set_on_a_machine_with_the_runtime_library_alone(monkeypatch, capsys):
+    pinned_devices = []
+
+    def load_library(name):
+        # a machine without the development package: only the runtime name resolves
+        if name != RUNTIME_LIBRARY:
+            raise OSError(f"{name}: cannot open shared object file: No such file or directory")
+        return SimpleNamespace(numa_available=lambda: 0)
+
+    nvml = SimpleNamespace(
+        nvmlInit=lambda: None,
+        nvmlShutdown=lambda: None,
+        nvmlDeviceGetHandleByIndex=lambda index: index,
+        nvmlDeviceSetCpuAffinity=pinned_devices.append,
+    )
+    monkeypatch.setattr(distributed, "ctypes", SimpleNamespace(CDLL=load_library))
+    monkeypatch.setitem(sys.modules, "pynvml", nvml)
+    monkeypatch.setattr(distributed, "is_npu_available", False)
+    monkeypatch.setattr(distributed.ray, "is_initialized", lambda: False)
+    monkeypatch.setenv("LOCAL_RANK", "3")
+
+    distributed.set_numa_affinity()
+
+    assert pinned_devices == [3]
+    assert capsys.readouterr().out == ""
diff --git a/verl/utils/distributed.py b/verl/utils/distributed.py
index 34707c77ad6a1916a1b1f7287f6f717ff85eed19..33d51f11e659211024f9e0ed48ff529fd89e2141 100644
--- a/verl/utils/distributed.py
+++ b/verl/utils/distributed.py
@@ -34,7 +34,8 @@ def set_numa_affinity():
 
     initialized = False
     try:
-        libnuma = ctypes.CDLL("libnuma.so")
+        # the runtime library's name: libnuma.so is the link of the development package, which a training machine lacks
+        libnuma = ctypes.CDLL("libnuma.so.1")
         if libnuma.numa_available() < 0:
             return
 
