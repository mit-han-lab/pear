From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pear <pear@localhost>
Date: Mon, 17 Sep 2001 00:00:00 +0000
Subject: [PATCH] [trainer] refactor: ReplayBufferAsync.is_stale, the
 off-policy drop test of a dispatch step

The staleness test of _stale_terminal_keys moves into a method, with the same result, so that a trainer can ask it
for a group that has not finished. Hook for the PEAR-specific resume, which restarts a restored group that is
already too stale to be trained.
---
 .../trainer/ppo/v1/test_replay_buffer_on_cpu.py  | 16 ++++++++++++++++
 verl/trainer/ppo/v1/replay_buffer.py             | 14 ++++++++++----
 2 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/tests/trainer/ppo/v1/test_replay_buffer_on_cpu.py b/tests/trainer/ppo/v1/test_replay_buffer_on_cpu.py
index 4e3f5bf99daac8feb572efc7f9f1ac0b4b1ec19b..96755da7e5ab13649cd7fa0aec0154bb74d933ec 100644
--- a/tests/trainer/ppo/v1/test_replay_buffer_on_cpu.py
+++ b/tests/trainer/ppo/v1/test_replay_buffer_on_cpu.py
@@ -1286,3 +1286,19 @@ def test_wait_for_sampleable_replaces_groups_sample_would_have_evicted(tq_init,
         assert _uids_of(batch.keys) == {refiller.produced_uids[0]}
     finally:
         _clear_partition(partition_id)
+
+
+def test_is_stale_only_under_the_drop_strategy():
+    def buffer(strategy: str) -> ReplayBufferAsync:
+        return ReplayBufferAsync(
+            trainer_mode="separate_async",
+            trainer_config={},
+            max_off_policy_threshold=5,
+            max_off_policy_strategy=strategy,
+            sampler_kwargs={},
+        )
+
+    # trained at step 10: dispatched at 6 spans 5 versions, at 5 spans 6
+    assert not buffer("drop").is_stale(global_steps=10, prompt_global_steps=6)
+    assert buffer("drop").is_stale(global_steps=10, prompt_global_steps=5)
+    assert not buffer("wait").is_stale(global_steps=10, prompt_global_steps=1)
diff --git a/verl/trainer/ppo/v1/replay_buffer.py b/verl/trainer/ppo/v1/replay_buffer.py
index 08e05ec488225b8b60a339e732f0b1d7edad88d8..da3b560fcfe2e08a4e21f3c397ec00a705fd7fba 100644
--- a/verl/trainer/ppo/v1/replay_buffer.py
+++ b/verl/trainer/ppo/v1/replay_buffer.py
@@ -517,15 +517,21 @@ class ReplayBufferAsync(ReplayBuffer):
     def _validate_mode_config(self) -> None:
         pass
 
+    def is_stale(self, global_steps: int, prompt_global_steps: int) -> bool:
+        """Whether a group dispatched at ``prompt_global_steps`` is dropped when it finishes at ``global_steps``."""
+        return (
+            self.max_off_policy_threshold is not None
+            and self.max_off_policy_strategy == "drop"
+            and global_steps - prompt_global_steps + 1 > self.max_off_policy_threshold
+        )
+
     def _stale_terminal_keys(self, global_steps: int, partition_id: str) -> set[str]:
-        if partition_id == "val" or self.max_off_policy_threshold is None or self.max_off_policy_strategy != "drop":
+        if partition_id == "val":
             return set()
         prompt_global_steps = self.prompt_global_steps[partition_id]
         terminal_keys = self.finished_keys[partition_id]
         return {
-            uid
-            for uid in terminal_keys
-            if global_steps - prompt_global_steps.get(uid, global_steps) + 1 > self.max_off_policy_threshold
+            uid for uid in terminal_keys if self.is_stale(global_steps, prompt_global_steps.get(uid, global_steps))
         }
 
     def _terminal_eviction_reasons(
