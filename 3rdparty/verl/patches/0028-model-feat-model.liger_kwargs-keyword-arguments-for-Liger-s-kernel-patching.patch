 verl/trainer/config/_generated_ppo_torchtitan_trainer.yaml | 2 ++
 verl/trainer/config/_generated_ppo_trainer.yaml            | 2 ++
 verl/trainer/config/_generated_ppo_veomni_trainer.yaml     | 2 ++
 verl/trainer/config/model/hf_model.yaml                    | 3 +++
 verl/workers/config/model.py                               | 1 +
 verl/workers/engine/fsdp/transformer_impl.py               | 7 ++-----
 7 files changed, 14 insertions(+), 5 deletions(-)

