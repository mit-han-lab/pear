From: pear <pear@localhost>
Date: Mon, 17 Sep 2001 00:00:00 +0000
Subject: [PATCH] [trainer] feat: one log line per timed phase of the v1
 trainer

trainer_base wraps marked_timer so that each timed phase logs "phase <name>" at INFO when it starts: a
reader of the trainer's log can tell which phase a step is in.
---
 verl/trainer/ppo/v1/trainer_base.py | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/verl/trainer/ppo/v1/trainer_base.py b/verl/trainer/ppo/v1/trainer_base.py
index 3056a9d3efb97eceb5cde5c0ffd29739c9f40187..0c34da8f05a91bb454e298e2ddedaabe4af9f889 100644
--- a/verl/trainer/ppo/v1/trainer_base.py
+++ b/verl/trainer/ppo/v1/trainer_base.py
@@ -22,6 +22,7 @@ import uuid
 from abc import ABC, abstractmethod
 from collections import defaultdict
 from concurrent.futures import ThreadPoolExecutor
+from contextlib import contextmanager
 from functools import partial
 from pprint import pprint
 from typing import Any, Optional
@@ -79,7 +80,7 @@ from verl.utils import tensordict_utils as tu
 from verl.utils.checkpoint.checkpoint_manager import find_latest_ckpt_path
 from verl.utils.config import omega_conf_to_dataclass
 from verl.utils.dataset.rl_dataset import collate_fn
-from verl.utils.debug import marked_timer
+from verl.utils.debug import marked_timer as _marked_timer
 from verl.utils.debug.metrics import calculate_debug_metrics
 from verl.utils.import_utils import load_extern_type
 from verl.utils.metric import reduce_metrics
@@ -101,6 +102,16 @@ def apply_greedy_sampling_params(params: dict[str, Any]) -> None:
 
 
 logger = logging.getLogger(__name__)
+
+
+@contextmanager
+def marked_timer(name, timing_raw, **kwargs):
+    """marked_timer that logs the phase it enters: the log then tells which phase the trainer is in."""
+    logger.info("phase %s", name)
+    with _marked_timer(name, timing_raw, **kwargs):
+        yield
+
+
 logger.setLevel(os.getenv("VERL_LOGGING_LEVEL", "INFO"))
 
 
