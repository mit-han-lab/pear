+def _topk_heads(count, k, start):
+    """Distinct assistant heads: row i holds ids start+i.. and log-probs -(start+i)."""
+    ids = (np.arange(count)[:, None] + start + np.arange(k)[None, :]).astype(np.int32)
+    return ids, -ids.astype(np.float32)
+
