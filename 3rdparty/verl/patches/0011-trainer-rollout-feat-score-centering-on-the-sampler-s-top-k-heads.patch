+def test_agent_loop_output_as_dict_promotes_rollout_topk_fields():
+    output = AgentLoopOutput(
+        prompt_ids=[1, 2, 3],
+        response_ids=[4, 5],
+        response_mask=[1, 1],
+        num_turns=2,
+        metrics=AgentLoopMetrics(),
+        extra_fields={
+            "response_topk_ids": [[4, 9], [5, 8]],
+            "response_topk_log_probs": [[-0.1, -2.0], [-0.2, -1.5]],
+        },
+    )
+
+    fields = output.as_dict()
+
+    # Unpadded full-sequence layout: row P-1+r holds response token r's head, other rows the dummy head.
+    assert fields["rollout_topk_ids"].shape == (5, 2) and fields["rollout_topk_ids"].dtype == torch.int32
+    assert fields["rollout_topk_log_probs"].shape == (5, 2) and fields["rollout_topk_log_probs"].dtype == torch.float32
+    assert fields["rollout_topk_ids"][2].tolist() == [4, 9] and fields["rollout_topk_ids"][3].tolist() == [5, 8]
+    assert fields["rollout_topk_ids"][0].tolist() == [0, 1]
+    assert fields["extra_fields"] == {}
+    assert output.extra_fields["response_topk_ids"] == [[4, 9], [5, 8]]
+
+
+def test_agent_loop_output_as_dict_lays_out_multi_turn_rollout_topk():
+    # a tool turn between two assistant turns: its tokens carry the uniform placeholder head
+    placeholder_ids, placeholder_log_probs = [0, 1], [-math.log(2)] * 2
+    output = AgentLoopOutput(
+        prompt_ids=[1],
+        response_ids=[2, 3, 4, 5],
+        response_mask=[1, 0, 0, 1],
+        num_turns=4,
+        metrics=AgentLoopMetrics(),
+        extra_fields={
+            "response_topk_ids": [[2, 9], placeholder_ids, placeholder_ids, [5, 8]],
+            "response_topk_log_probs": [[-0.1, -2.0], placeholder_log_probs, placeholder_log_probs, [-0.2, -1.5]],
+        },
+    )
+
+    fields = output.as_dict()
+
+    # row P-1+r holds response token r's head, the last row the dummy head
+    assert fields["rollout_topk_ids"].tolist() == [[2, 9], [0, 1], [0, 1], [5, 8], [0, 1]]
+    assert fields["rollout_topk_log_probs"][3].tolist() == pytest.approx([-0.2, -1.5])
+
+
+def test_agent_loop_output_as_dict_rejects_a_head_per_token_mismatch():
+    output = AgentLoopOutput(
+        prompt_ids=[1],
+        response_ids=[2, 3, 4],
+        response_mask=[1, 0, 1],
+        num_turns=4,
+        metrics=AgentLoopMetrics(),
+        extra_fields={"response_topk_ids": [[2, 9], [4, 8]], "response_topk_log_probs": [[-0.1, -2.0], [-0.2, -1.5]]},
+    )
+
+    with pytest.raises(ValueError, match="one sampler top-2 head per response token"):
