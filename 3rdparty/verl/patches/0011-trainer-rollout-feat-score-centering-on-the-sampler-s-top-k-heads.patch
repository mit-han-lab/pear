+import asyncio
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from verl.workers.rollout import llm_server
+from verl.workers.rollout.llm_server import FullyAsyncLLMServerClient
+from verl.workers.rollout.replica import TokenOutput
+
+K = 3
+
+
+def _heads(first: int, count: int) -> dict:
+    """Sampler top-k heads for `count` generated tokens, row i holding ids first+i.. and log-probs -(first+i)."""
+    ids = (np.arange(first, first + count)[:, None] + np.arange(K)[None, :]).astype(np.int32)
+    return {"response_topk_ids": ids, "response_topk_log_probs": -ids.astype(np.float32)}
+
+
+def _install_segments(monkeypatch: pytest.MonkeyPatch, segments: list[TokenOutput]) -> None:
+    """Script the upstream so each resume attempt returns the next segment (the base class is patched: super())."""
+    pending = iter(segments)
+
+    async def fake_generate(self, request_id, *, prompt_ids, **kwargs):
+        return next(pending)
+
+    monkeypatch.setattr(llm_server.LLMServerClient, "generate", fake_generate)
+    real_sleep = asyncio.sleep
+
+    async def no_wait(_delay, *args, **kwargs):
+        return await real_sleep(0, *args, **kwargs)
+
+    monkeypatch.setattr(llm_server.asyncio, "sleep", no_wait)
+
+
+def _generate(monkeypatch, segments: list[TokenOutput]) -> TokenOutput:
+    _install_segments(monkeypatch, segments)
+    client = FullyAsyncLLMServerClient(config=SimpleNamespace(), load_balancer_handle=None)
+    return asyncio.run(client.generate(request_id="req-0", prompt_ids=[1, 2, 3], sampling_params={}))
+
+
+def test_heads_of_every_attempt_are_concatenated(monkeypatch):
+    # two aborts (the second one empty, as an abort before any token is sampled) then completion
+    segments = [
+        TokenOutput(token_ids=[101, 102], stop_reason="aborted", extra_fields={"global_steps": 5, **_heads(100, 2)}),
+        TokenOutput(token_ids=[], stop_reason="aborted", extra_fields={"global_steps": 5}),
+        TokenOutput(
+            token_ids=[103, 104, 105], stop_reason="completed", extra_fields={"global_steps": 6, **_heads(200, 3)}
+        ),
+    ]
+    output = _generate(monkeypatch, segments)
+
+    assert output.token_ids == [101, 102, 103, 104, 105]
+    expected = np.concatenate([_heads(100, 2)["response_topk_ids"], _heads(200, 3)["response_topk_ids"]])
+    np.testing.assert_array_equal(output.extra_fields["response_topk_ids"], expected)
+    np.testing.assert_array_equal(output.extra_fields["response_topk_log_probs"], -expected.astype(np.float32))
+    assert (output.extra_fields["min_global_steps"], output.extra_fields["max_global_steps"]) == (5, 6)
+
+
+def test_no_heads_requested_adds_no_fields(monkeypatch):
+    segment = TokenOutput(token_ids=[101], stop_reason="completed", extra_fields={"global_steps": 5})
+    output = _generate(monkeypatch, [segment])
+
+    assert "response_topk_ids" not in output.extra_fields
+
+
+def test_tokens_without_heads_fail_loudly(monkeypatch):
+    segments = [
+        TokenOutput(token_ids=[101, 102], stop_reason="aborted", extra_fields={"global_steps": 5, **_heads(100, 2)}),
+        TokenOutput(token_ids=[103], stop_reason="completed", extra_fields={"global_steps": 6}),
+    ]
+    with pytest.raises(RuntimeError, match="2 sampler top-k heads for 3 generated tokens"):
+        _generate(monkeypatch, segments)
