+def extract_response_topk_logprobs(
+    logprobs, token_ids: list[int], k: int
+) -> tuple[list[float], np.ndarray, np.ndarray]:
+    """Split vLLM ``FlatLogprobs`` of a generated sequence into the sampled tokens' log-probs and the top-k heads.
+
+    vLLM records every position as the sampled token followed by the top-k candidates by rank (``k + 1`` entries; the
+    sampled token appears twice when it is inside the head), so the flat lists reshape to ``(n, k + 1)`` without a
+    per-token Python loop.
+
+    Args:
+        logprobs: ``RequestOutput.outputs[0].logprobs`` of a request made with ``logprobs=k, flat_logprobs=True``.
+        token_ids: The generated token ids, one per position.
+        k: Head size.
+
+    Returns:
+        Tuple containing:
+            sampled_log_probs: Log-prob of each generated token, list of floats.
+            topk_ids: Head token ids by rank, shape (n, k), dtype int32.
+            topk_log_probs: Head log-probs matching ``topk_ids``, shape (n, k), dtype float32.
+    """
+    if not hasattr(logprobs, "start_indices"):
+        raise TypeError("the sampler top-k head expects vLLM FlatLogprobs (a request with flat_logprobs=True).")
+    n = len(token_ids)
+    if len(logprobs.token_ids) != n * (k + 1) or not np.array_equal(
+        np.asarray(logprobs.start_indices, dtype=np.int64), np.arange(0, n * (k + 1), k + 1)
+    ):
+        raise ValueError(f"expected {k + 1} logprob entries at each of the {n} generated positions")
+    ids = np.asarray(logprobs.token_ids, dtype=np.int64).reshape(n, k + 1)
+    log_probs = np.asarray(logprobs.logprobs, dtype=np.float32).reshape(n, k + 1)
+    ranks = np.asarray(logprobs.ranks, dtype=np.int64).reshape(n, k + 1)
+    sampled_first = np.array_equal(ids[:, 0], np.asarray(token_ids, dtype=np.int64))
+    if not sampled_first or (ranks[:, 1:] != np.arange(1, k + 1)).any():
+        raise ValueError("vLLM logprobs are not laid out as the sampled token followed by the top-k by rank.")
+    return log_probs[:, 0].tolist(), ids[:, 1:].astype(np.int32), np.ascontiguousarray(log_probs[:, 1:])
+
