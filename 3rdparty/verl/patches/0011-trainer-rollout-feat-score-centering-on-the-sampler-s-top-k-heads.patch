+import numpy as np
+import pytest
+
+vllm_logprobs = pytest.importorskip("vllm.logprobs")
+
+from verl.workers.rollout.utils import extract_response_topk_logprobs  # noqa: E402
+
+K = 3
+
+
+def _vllm_positions(flat: bool):
+    """Two generated positions recorded the way vLLM's sampler records them: the sampled token, then the top-k."""
+    container = vllm_logprobs.create_sample_logprobs(flat)
+    # position 0: the sampled token 7 is the top-1 token (vLLM lists it twice)
+    vllm_logprobs.append_logprobs_for_next_position(
+        container, [7, 7, 3, 9], [-0.1, -0.1, -1.5, -2.0], [None] * 4, rank=1, num_logprobs=K
+    )
+    # position 1: the sampled token 42 is outside the head (rank 17)
+    vllm_logprobs.append_logprobs_for_next_position(
+        container, [42, 3, 7, 9], [-8.0, -0.2, -1.0, -1.9], [None] * 4, rank=17, num_logprobs=K
+    )
+    return container
+
+
+def test_extract_splits_sampled_token_and_head_by_rank():
+    sampled, ids, log_probs = extract_response_topk_logprobs(_vllm_positions(flat=True), [7, 42], K)
+
+    np.testing.assert_allclose(sampled, [-0.1, -8.0], rtol=1e-6)
+    assert ids.dtype == np.int32 and log_probs.dtype == np.float32
+    np.testing.assert_array_equal(ids, [[7, 3, 9], [3, 7, 9]])
+    np.testing.assert_allclose(log_probs, [[-0.1, -1.5, -2.0], [-0.2, -1.0, -1.9]], rtol=1e-6)
+
+
+def test_extract_matches_the_dict_layout():
+    # the per-position dicts of the default (non-flat) layout hold the same head and sampled log-prob
+    positions = _vllm_positions(flat=False)
+    sampled, ids, log_probs = extract_response_topk_logprobs(_vllm_positions(flat=True), [7, 42], K)
+
+    for i, (token_id, position) in enumerate(zip([7, 42], positions, strict=True)):
+        assert position[token_id].logprob == pytest.approx(sampled[i])
+        head = sorted((lp.rank, tid, lp.logprob) for tid, lp in position.items() if lp.rank <= K)
+        assert [tid for _, tid, _ in head] == ids[i].tolist()
+        np.testing.assert_allclose([lp for _, _, lp in head], log_probs[i], rtol=1e-6)
+
+
+def test_extract_handles_an_empty_generation():
+    sampled, ids, log_probs = extract_response_topk_logprobs(vllm_logprobs.create_sample_logprobs(True), [], K)
+
+    assert sampled == [] and ids.shape == (0, K) and log_probs.shape == (0, K)
+
+
+def test_extract_rejects_dict_logprobs():
+    with pytest.raises(TypeError):
+        extract_response_topk_logprobs(_vllm_positions(flat=False), [7, 42], K)
+
+
+def test_extract_rejects_a_sampled_token_mismatch_and_a_short_head():
+    with pytest.raises(ValueError, match="laid out"):
+        extract_response_topk_logprobs(_vllm_positions(flat=True), [7, 43], K)
+    with pytest.raises(ValueError, match="entries"):
+        extract_response_topk_logprobs(_vllm_positions(flat=True), [7, 42], K + 1)
