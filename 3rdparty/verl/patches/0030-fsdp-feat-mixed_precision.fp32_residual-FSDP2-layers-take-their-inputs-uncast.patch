From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pear <pear@localhost>
Date: Mon, 17 Sep 2001 00:00:00 +0000
Subject: [PATCH] [fsdp] feat: mixed_precision.fp32_residual, FSDP2 layers take
 their inputs uncast

With mixed_precision.fp32_residual the FSDP2 mixed-precision policy is built with cast_forward_inputs=False: a
wrapped layer receives its inputs in the dtype they arrive in, not cast to param_dtype. Unset, nothing changes.
---
 verl/workers/engine/fsdp/transformer_impl.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/verl/workers/engine/fsdp/transformer_impl.py b/verl/workers/engine/fsdp/transformer_impl.py
index 639611178d594c132ca01d8868f913b306e7cd9d..04293829823a827d224c6e7b4e80e50554991c25 100644
--- a/verl/workers/engine/fsdp/transformer_impl.py
+++ b/verl/workers/engine/fsdp/transformer_impl.py
@@ -453,8 +453,11 @@ class FSDPEngine(BaseEngine):
             # - critic: offload_policy
             # - ref: CPUOffloadPolicy(pin_memory=True)
             assert CPUOffloadPolicy is not None, "PyTorch version >= 2.4 is required for using fully_shard API (FSDP2)"
+            # mixed_precision.fp32_residual: the layers take the fp32 residual stream as it is, not cast to param_dtype
             mp_policy = MixedPrecisionPolicy(
-                param_dtype=param_dtype, reduce_dtype=reduce_dtype, cast_forward_inputs=True
+                param_dtype=param_dtype,
+                reduce_dtype=reduce_dtype,
+                cast_forward_inputs=not (mixed_precision_config or {}).get("fp32_residual", False),
             )
             offload_policy = None
             if self.engine_config.offload_policy or self.engine_config.forward_only:
