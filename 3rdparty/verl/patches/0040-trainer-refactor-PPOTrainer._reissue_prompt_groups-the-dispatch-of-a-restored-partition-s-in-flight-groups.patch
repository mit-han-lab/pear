From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pear <pear@localhost>
Date: Mon, 17 Sep 2001 00:00:00 +0000
Subject: [PATCH] [trainer] refactor: PPOTrainer._reissue_prompt_groups, the
 dispatch of a restored partition's in-flight groups

What _reissue_inflight_prompts did once it had dropped the consumed trajectories and selected the in-flight groups,
as a method, and the statuses it selects as the class attribute INFLIGHT_PROMPT_STATUSES: a subclass that resumes
its groups another way, or keeps a status of its own, replaces these two instead of the whole method. Nothing
changes by default.
---
 .../ppo/v1/test_reissue_inflight_on_cpu.py    |  6 +++--
 .../test_reissue_inflight_prompts_on_cpu.py   | 26 ++++++++++++++++++-
 verl/trainer/ppo/v1/trainer_base.py           |  9 ++++++-
 3 files changed, 37 insertions(+), 4 deletions(-)

diff --git a/tests/trainer/ppo/v1/test_reissue_inflight_on_cpu.py b/tests/trainer/ppo/v1/test_reissue_inflight_on_cpu.py
index 17a1dd10faed03ed63f74461694030ce4e6e4e4d..4a898a64b13ff6b223cf050ad46c99cb9b9bcfba 100644
--- a/tests/trainer/ppo/v1/test_reissue_inflight_on_cpu.py
+++ b/tests/trainer/ppo/v1/test_reissue_inflight_on_cpu.py
@@ -79,13 +79,15 @@ class FakeAgentLoopManager:
 
 
 def _make_trainer_stub(trainer_mode: str = "separate_async", global_steps: int = 8):
-    """Bind the real ``_reissue_inflight_prompts`` to a stub exposing only what it uses
-    (``agent_loop_manager``, ``trainer_mode``, and ``global_steps``)."""
+    """Bind the real ``_reissue_inflight_prompts`` and its ``_reissue_prompt_groups`` to a stub exposing only what
+    they use (``agent_loop_manager``, ``trainer_mode``, ``global_steps`` and the in-flight statuses)."""
     stub = type("Stub", (), {})()
     stub.trainer_mode = trainer_mode
     stub.global_steps = global_steps
     stub.agent_loop_manager = FakeAgentLoopManager()
+    stub.INFLIGHT_PROMPT_STATUSES = PPOTrainer.INFLIGHT_PROMPT_STATUSES
     stub._reissue_inflight_prompts = PPOTrainer._reissue_inflight_prompts.__get__(stub)
+    stub._reissue_prompt_groups = PPOTrainer._reissue_prompt_groups.__get__(stub)
     return stub
 
 
diff --git a/tests/trainer/ppo/v1/test_reissue_inflight_prompts_on_cpu.py b/tests/trainer/ppo/v1/test_reissue_inflight_prompts_on_cpu.py
index f290c62c321fc37f8c52803b9a7661c3a021e9ce..d0c76a901a105127a1ec05b0a96b2e2375d5232f 100644
--- a/tests/trainer/ppo/v1/test_reissue_inflight_prompts_on_cpu.py
+++ b/tests/trainer/ppo/v1/test_reissue_inflight_prompts_on_cpu.py
@@ -1,3 +1,4 @@
+from functools import partial
 from types import SimpleNamespace
 from unittest.mock import MagicMock
 
@@ -15,7 +16,13 @@ def restore(monkeypatch):
         tq = MagicMock(kv_list=MagicMock(return_value={"train": items}))
         monkeypatch.setattr(trainer_base, "tq", tq)
         monkeypatch.setattr(trainer_base.tu, "assign_non_tensor_data", MagicMock())
-        trainer = SimpleNamespace(trainer_mode="separate_async", global_steps=7, agent_loop_manager=MagicMock())
+        trainer = SimpleNamespace(
+            trainer_mode="separate_async",
+            global_steps=7,
+            agent_loop_manager=MagicMock(),
+            INFLIGHT_PROMPT_STATUSES=PPOTrainer.INFLIGHT_PROMPT_STATUSES,
+        )
+        trainer._reissue_prompt_groups = partial(PPOTrainer._reissue_prompt_groups, trainer)
         reissued = PPOTrainer._reissue_inflight_prompts(trainer)
         return reissued, {key for call in tq.kv_clear.call_args_list for key in call.kwargs["keys"]}
 
@@ -36,3 +43,20 @@ def test_consumed_rows_are_dropped_and_the_finished_groups_kept(restore):
 def test_without_inflight_prompts(restore):
     items = {"fin": {"is_prompt": True, "status": "finished", "global_steps": 6}, "fin_0_0": {}, "old_0_0": {}}
     assert restore(items) == (0, {"old_0_0"})
+
+
+def test_the_groups_of_the_trainer_s_statuses_go_to_its_hook_whose_count_is_returned(monkeypatch):
+    items = {
+        "que": {"is_prompt": True, "status": "queued", "global_steps": 5},
+        "run": {"is_prompt": True, "status": "running", "global_steps": 6},
+        "fin": {"is_prompt": True, "status": "finished", "global_steps": 6},
+    }
+    monkeypatch.setattr(trainer_base, "tq", MagicMock(kv_list=MagicMock(return_value={"train": items})))
+    trainer = SimpleNamespace(
+        trainer_mode="separate_async",
+        INFLIGHT_PROMPT_STATUSES=("queued", "running"),
+        _reissue_prompt_groups=MagicMock(return_value=5),
+    )
+
+    assert PPOTrainer._reissue_inflight_prompts(trainer) == 5
+    trainer._reissue_prompt_groups.assert_called_once_with(["que", "run"], items, "train")
diff --git a/verl/trainer/ppo/v1/trainer_base.py b/verl/trainer/ppo/v1/trainer_base.py
index 8eb2d46db470915b4558aedfa2152ce0ad677c30..95a089e97b7706a9258c82bba7e709ab2f3b718f 100644
--- a/verl/trainer/ppo/v1/trainer_base.py
+++ b/verl/trainer/ppo/v1/trainer_base.py
@@ -130,6 +130,9 @@ class PPOTrainer(ABC):
         config: DictConfig from yaml config file.
     """
 
+    # the statuses of a checkpointed prompt group whose generation a resume starts again
+    INFLIGHT_PROMPT_STATUSES = ("pending", "running")
+
     def __init__(self, config: DictConfig):
         self.config = config
         self.checkpoint_callback = build_checkpoint_callback(config)
@@ -949,11 +952,15 @@ class PPOTrainer(ABC):
         inflight_uids = [
             key
             for key, tag in items.items()
-            if tag.get("is_prompt", False) and tag.get("status") in ("pending", "running")
+            if tag.get("is_prompt", False) and tag.get("status") in self.INFLIGHT_PROMPT_STATUSES
         ]
         if not inflight_uids:
             return 0
 
+        return self._reissue_prompt_groups(inflight_uids, items, partition_id)
+
+    def _reissue_prompt_groups(self, inflight_uids: list[str], items: dict[str, dict], partition_id: str) -> int:
+        """Dispatch a restored partition's in-flight prompt groups again, given the partition's tags by key."""
         batch = tq.kv_batch_get(keys=inflight_uids, partition_id=partition_id)
         inflight_uid_set = set(inflight_uids)
         old_trajectory_keys = [
