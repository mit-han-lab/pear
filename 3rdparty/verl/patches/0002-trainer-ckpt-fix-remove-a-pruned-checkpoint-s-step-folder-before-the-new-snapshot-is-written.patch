From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pear <pear@localhost>
Date: Mon, 17 Sep 2001 00:00:00 +0000
Subject: [PATCH] [trainer, ckpt] fix: remove a pruned checkpoint's step folder
 before the new snapshot is written

Pruning an actor checkpoint left its global_step folder behind, with data.pt and the TransferQueue
snapshot. _save_checkpoint now removes these folders after the actor and critic saves and before it
writes the new step's data.pt and snapshot, so a pruned step's snapshot never sits next to the new one.
---
 ...heckpoint_retention_after_resume_on_cpu.py | 59 +++++++++++++++++++
 verl/trainer/ppo/v1/trainer_base.py           | 16 +++++
 2 files changed, 75 insertions(+)

diff --git a/tests/trainer/ppo/v1/test_checkpoint_retention_after_resume_on_cpu.py b/tests/trainer/ppo/v1/test_checkpoint_retention_after_resume_on_cpu.py
index 3efb62087cd2bf21b2bdcbce31c0d0ee8edfba47..302164454c90786838e84e51ee1d788390c25ccd 100644
--- a/tests/trainer/ppo/v1/test_checkpoint_retention_after_resume_on_cpu.py
+++ b/tests/trainer/ppo/v1/test_checkpoint_retention_after_resume_on_cpu.py
@@ -1,7 +1,12 @@
 import os
+import shutil
+import types
 
 import pytest
+from omegaconf import OmegaConf
 
+from verl.trainer.ppo.v1 import trainer_base
+from verl.trainer.ppo.v1.trainer_base import PPOTrainer
 from verl.utils.checkpoint.checkpoint_manager import BaseCheckpointManager
 
 
@@ -35,3 +40,57 @@ def test_resume_registers_the_older_siblings_in_order(tmp_path, manager, make_st
 def test_resume_ignores_paths_outside_the_step_layout(tmp_path, manager):
     manager.register_existing_checkpoints(os.path.join(tmp_path, "somewhere", "actor"))
     assert manager.previous_saved_paths == []
+
+
+class SavingTrainer(PPOTrainer):
+    """PPOTrainer with the step hooks, which a checkpoint save never reaches."""
+
+    def on_sample_end(self):
+        return
+
+    def on_step_end(self):
+        return
+
+
+def test_pruned_step_folders_go_before_the_transfer_queue_snapshot(tmp_path, make_step, monkeypatch):
+    # saving step 6 with max_actor_ckpt_to_keep=2 prunes step 4's actor: step 4's folder (its data.pt and its snapshot)
+    # must be gone when step 6's snapshot is written, so that two old snapshots never sit next to the new one
+    make_step(4)
+    make_step(5)
+    folders_at_snapshot = []
+
+    def save_actor(local_path, remote_path, step, max_ckpt_to_keep):
+        os.makedirs(local_path)
+        shutil.rmtree(os.path.join(tmp_path, "global_step_4", "actor"))
+
+    monkeypatch.setattr(
+        trainer_base.tq,
+        "save_checkpoint",
+        lambda path, metadata: folders_at_snapshot.append(sorted(os.listdir(tmp_path))),
+    )
+    trainer = SavingTrainer.__new__(SavingTrainer)
+    trainer.config = OmegaConf.create(
+        {
+            "trainer": {"default_local_dir": str(tmp_path), "default_hdfs_dir": None, "max_actor_ckpt_to_keep": 2},
+            "actor_rollout_ref": {"actor": {"checkpoint": {}}},
+        }
+    )
+    trainer.global_steps = 6
+    trainer.actor_rollout_wg = types.SimpleNamespace(save_checkpoint=save_actor)
+    trainer.use_critic = False
+    trainer.train_dataloader = types.SimpleNamespace(state_dict=lambda: {})
+    trainer.trainer_mode = "separate_async"
+    trainer.checkpoint_callback = types.SimpleNamespace(on_save=lambda **kwargs: None)
+
+    trainer._save_checkpoint()
+
+    assert folders_at_snapshot == [["global_step_5", "global_step_6"]]
+
+
+def test_pruned_step_folders_are_removed_but_live_ones_kept(tmp_path, make_step):
+    make_step(3, actor=False)
+    make_step(4, actor=False)
+    make_step(5)
+    make_step(6)
+    PPOTrainer._remove_pruned_step_folders(str(tmp_path), 6)
+    assert sorted(os.listdir(tmp_path)) == ["global_step_5", "global_step_6"]
diff --git a/verl/trainer/ppo/v1/trainer_base.py b/verl/trainer/ppo/v1/trainer_base.py
index ed3412b5980030d04bb86b5345fa5a9adce03cf9..28b6b6bb751336812eb07035dac78061484c73ee 100644
--- a/verl/trainer/ppo/v1/trainer_base.py
+++ b/verl/trainer/ppo/v1/trainer_base.py
@@ -16,6 +16,8 @@ import json
 import logging
 import math
 import os
+import re
+import shutil
 import uuid
 from abc import ABC, abstractmethod
 from collections import defaultdict
@@ -945,6 +947,16 @@ class PPOTrainer(ABC):
         )
         return len(inflight_uids)
 
+    @staticmethod
+    def _remove_pruned_step_folders(default_local_dir: str, current_step: int) -> None:
+        """Remove the global_step folders whose actor checkpoint was pruned: data.pt and the transfer_queue snapshot
+        keep them alive."""
+        for entry in os.listdir(default_local_dir):
+            match = re.fullmatch(r"global_step_(\d+)", entry)
+            folder = os.path.join(default_local_dir, entry)
+            if match and int(match.group(1)) < current_step and not os.path.isdir(os.path.join(folder, "actor")):
+                shutil.rmtree(folder, ignore_errors=True)
+
     def _save_checkpoint(self):
         """Save actor, critic, and dataloader checkpoints to local (and optionally remote) storage."""
         from verl.utils.fs import local_mkdir_safe
@@ -993,6 +1005,10 @@ class PPOTrainer(ABC):
                 critic_local_path, critic_remote_path, self.global_steps, max_ckpt_to_keep=max_critic_ckpt_to_keep
             )
 
+        # the step folders whose actor was just pruned go before this step's transfer-queue snapshot is written: their
+        # own snapshots would otherwise sit next to it at the peak of the save
+        self._remove_pruned_step_folders(self.config.trainer.default_local_dir, self.global_steps)
+
         # save dataloader state
         local_mkdir_safe(local_global_step_folder)
         dataloader_local_path = os.path.join(local_global_step_folder, "data.pt")
