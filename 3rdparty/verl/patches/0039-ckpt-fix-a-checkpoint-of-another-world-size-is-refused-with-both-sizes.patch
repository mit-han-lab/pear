From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pear <pear@localhost>
Date: Mon, 17 Sep 2001 00:00:00 +0000
Subject: [PATCH] [ckpt] fix: a checkpoint of another world size is refused
 with both sizes

FSDPCheckpointManager names a checkpoint's shard files by the world size, so a load in another world size ended in
a FileNotFoundError for a file such as model_world_size_16_rank_0.pt. load_checkpoint now first reads the world
size the checkpoint recorded (fsdp_config.json) and raises with both sizes. A remote path, or a checkpoint without
that file, is loaded as before.
---
 .../utils/ckpt/test_fsdp_world_size_on_cpu.py | 25 +++++++++++++++++++
 .../checkpoint/fsdp_checkpoint_manager.py     | 16 ++++++++++++
 2 files changed, 41 insertions(+)
 create mode 100644 tests/utils/ckpt/test_fsdp_world_size_on_cpu.py

diff --git a/tests/utils/ckpt/test_fsdp_world_size_on_cpu.py b/tests/utils/ckpt/test_fsdp_world_size_on_cpu.py
new file mode 100644
index 0000000000000000000000000000000000000000..0ff1131f8d251408835924310330bde50726180a
--- /dev/null
+++ b/tests/utils/ckpt/test_fsdp_world_size_on_cpu.py
@@ -0,0 +1,25 @@
+import json
+
+import pytest
+
+from verl.utils.checkpoint.fsdp_checkpoint_manager import FSDPCheckpointManager
+
+
+def _manager(world_size):
+    manager = FSDPCheckpointManager.__new__(FSDPCheckpointManager)
+    manager.world_size = world_size
+    return manager
+
+
+def test_a_checkpoint_of_another_world_size_is_refused_with_both_sizes(tmp_path):
+    (tmp_path / "fsdp_config.json").write_text(json.dumps({"FSDP_version": 2, "world_size": 8}))
+
+    with pytest.raises(ValueError, match="saved by 8 trainer processes and this run has 16"):
+        _manager(16).load_checkpoint(str(tmp_path))
+
+
+def test_a_checkpoint_of_this_world_size_or_without_its_config_passes_the_check(tmp_path):
+    _manager(8)._require_saved_world_size(str(tmp_path))
+
+    (tmp_path / "fsdp_config.json").write_text(json.dumps({"FSDP_version": 2, "world_size": 8}))
+    _manager(8)._require_saved_world_size(str(tmp_path))
diff --git a/verl/utils/checkpoint/fsdp_checkpoint_manager.py b/verl/utils/checkpoint/fsdp_checkpoint_manager.py
index 757fabec238789be62a81199f4ab58b7d5c47de3..ba7b0574f47e6b2fe534a45398ae672498c2b4a0 100644
--- a/verl/utils/checkpoint/fsdp_checkpoint_manager.py
+++ b/verl/utils/checkpoint/fsdp_checkpoint_manager.py
@@ -174,6 +174,21 @@ class FSDPCheckpointManager(BaseCheckpointManager):
         )
         return {**current_state_dict, **state_dict}
 
+    def _require_saved_world_size(self, local_path: str) -> None:
+        """Raise unless the checkpoint was saved by this world size, by which its shard files are named."""
+        fsdp_config_path = os.path.join(local_path, "fsdp_config.json")
+        # a remote path, or a checkpoint saved without its config: the load goes on and names the file it misses
+        if not os.path.exists(fsdp_config_path):
+            return
+
+        with open(fsdp_config_path) as f:
+            saved_world_size = json.load(f)["world_size"]
+        if saved_world_size != self.world_size:
+            raise ValueError(
+                f"the checkpoint {local_path} was saved by {saved_world_size} trainer processes and this run has "
+                f"{self.world_size}: its shard files are named by that world size, so a resume needs the same number"
+            )
+
     def load_checkpoint(self, local_path: str, hdfs_path: str = None, del_local_after_load=False):
         """
         Load an FSDP checkpoint for this rank.
@@ -189,6 +204,7 @@ class FSDPCheckpointManager(BaseCheckpointManager):
         """
         if local_path is None:
             return
+        self._require_saved_world_size(local_path)
         self.register_existing_checkpoints(local_path)
 
         # check if the checkpoint_load_contents is valid
