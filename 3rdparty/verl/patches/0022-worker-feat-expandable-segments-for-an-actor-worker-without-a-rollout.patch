From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pear <pear@localhost>
Date: Mon, 17 Sep 2001 00:00:00 +0000
Subject: [PATCH] [worker] feat: expandable segments for an actor worker
 without a rollout

A standalone actor turns the allocator's expandable segments on before its first allocation, against the
fragmentation of its updates; the colocated worker already toggles them around its rollout's wake-ups.
---
 verl/workers/engine_workers.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/verl/workers/engine_workers.py b/verl/workers/engine_workers.py
index aa8f31c1fa650469601e47ae12f0e2c46411b1c0..8ba509c29bd3b86c3afd8e6554ab9e52f7cfc444 100644
--- a/verl/workers/engine_workers.py
+++ b/verl/workers/engine_workers.py
@@ -475,6 +475,10 @@ class ActorRolloutRefWorker(Worker, DistProfilerExtension):
         self._is_actor = self.role in ["actor", "actor_rollout", "actor_rollout_ref"]
         self._is_rollout = self.role in ["rollout", "actor_rollout", "actor_rollout_ref"]
         self._is_ref = self.role in ["ref", "actor_rollout_ref"]
+        if self._is_actor and not self._is_rollout:
+            # a standalone actor trains with expandable segments from its first allocation (fragmentation of the update
+            # otherwise reserves extra memory); the colocated worker toggles them around its rollout's wake-ups
+            set_expandable_segments(True)
 
         if self._is_actor:
             omega_profiler_config = config.actor.get("profiler", {})
