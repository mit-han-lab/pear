From: pear <pear@localhost>
Date: Mon, 17 Sep 2001 00:00:00 +0000
Subject: [PATCH] [trainer] refactor: the standalone replicas' config and start
 as methods of the separate-async trainer

_setup built the standalone config and its server manager inline. As _standalone_config and
_create_standalone_server_manager, a subclass can start the replicas elsewhere, for example while the training
engines initialize. Nothing changes by default.
---
 .../test_separate_async_step_switch_on_cpu.py | 11 +++++++
 verl/trainer/ppo/v1/trainer_separate_async.py | 29 ++++++++++++-------
 2 files changed, 29 insertions(+), 11 deletions(-)

diff --git a/tests/trainer/ppo/v1/test_separate_async_step_switch_on_cpu.py b/tests/trainer/ppo/v1/test_separate_async_step_switch_on_cpu.py
index 761600d10c46dd6854be32224ae98246a95ada24..050f79588618cd5157b1e3335f6481e12bd01b3a 100644
--- a/tests/trainer/ppo/v1/test_separate_async_step_switch_on_cpu.py
+++ b/tests/trainer/ppo/v1/test_separate_async_step_switch_on_cpu.py
@@ -591,3 +591,14 @@ def test_setup_standalone_memory_from_hydra_override(monkeypatch, model_engine,
     assert created_configs[0][0].actor_rollout_ref.rollout.gpu_memory_utilization == expected
     assert trainer.config.actor_rollout_ref.rollout.gpu_memory_utilization == 0.45
     assert OmegaConf.to_container(trainer.config, resolve=False) == original
+
+
+def test_setup_takes_the_standalone_server_manager_from_its_hook(monkeypatch):
+    trainer, created_configs, _ = _memory_budget_setup(monkeypatch, False, None)
+    standalone_server_manager = SimpleNamespace(get_replicas=lambda: ["standalone"])
+    trainer._create_standalone_server_manager = lambda: standalone_server_manager
+
+    trainer._setup()
+
+    assert trainer.standalone_server_manager is standalone_server_manager
+    assert created_configs == []
