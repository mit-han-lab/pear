From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pear <pear@localhost>
Date: Mon, 17 Sep 2001 00:00:00 +0000
Subject: [PATCH] [fsdp] feat: mixed_precision.fp32_modules, submodules
 gathered and computed in fp32 under FSDP2

The submodules named in mixed_precision.fp32_modules become FSDP2 units of their own with an fp32 policy, use SDPA
attention and run their forward with autocast off. mixed_precision.fp32_modules_tf32 chooses between IEEE fp32
(default) and TF32 for their matmuls and convolutions, through the process-wide flags.
---
 tests/utils/test_fsdp2_fp32_modules_on_gpu.py | 109 ++++++++++++++++++
 verl/utils/fsdp_utils.py                      |  38 +++++-
 2 files changed, 146 insertions(+), 1 deletion(-)
 create mode 100644 tests/utils/test_fsdp2_fp32_modules_on_gpu.py

diff --git a/tests/utils/test_fsdp2_fp32_modules_on_gpu.py b/tests/utils/test_fsdp2_fp32_modules_on_gpu.py
new file mode 100644
index 0000000000000000000000000000000000000000..f34f1adfc219e830f40b4a64b518eaa46c34b559
--- /dev/null
+++ b/tests/utils/test_fsdp2_fp32_modules_on_gpu.py
@@ -0,0 +1,109 @@
+import os
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.distributed as dist
+import torch.nn as nn
+from torch.distributed.device_mesh import init_device_mesh
+
+from verl.utils.fsdp_utils import MixedPrecisionPolicy, apply_fsdp2
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="FSDP2 mixed precision needs a GPU")
+
+
+class MockVisionBlock(nn.Module):
+    def __init__(self, hidden):
+        super().__init__()
+        self.fc = nn.Linear(hidden, hidden)
+
+    def forward(self, x):
+        return x + self.fc(x)
+
+
+class MockVision(nn.Module):
+    def __init__(self, hidden):
+        super().__init__()
+        self.config = SimpleNamespace(_attn_implementation="flash_attention_2")
+        self.patch = nn.Linear(hidden, hidden)
+        self.pos_embed = nn.Embedding(4, hidden)
+        self.blocks = nn.ModuleList([MockVisionBlock(hidden) for _ in range(2)])
+
+    def forward(self, pixels):
+        x = self.patch(pixels) + self.pos_embed(torch.arange(4, device=pixels.device)).sum(0)
+        for block in self.blocks:
+            x = block(x)
+        return x
+
+
+class MockDecoderLayer(nn.Module):
+    def __init__(self, hidden):
+        super().__init__()
+        self.fc = nn.Linear(hidden, hidden)
+
+    def forward(self, x):
+        return x + self.fc(x)
+
+
+class MockVLM(nn.Module):
+    _no_split_modules = ["MockDecoderLayer", "MockVisionBlock"]
+
+    def __init__(self, hidden=64):
+        super().__init__()
+        self.config = SimpleNamespace(tie_word_embeddings=False)
+        self.model = nn.Module()
+        self.model.visual = MockVision(hidden)
+        self.model.layers = nn.ModuleList([MockDecoderLayer(hidden) for _ in range(2)])
+        self.lm_head = nn.Linear(hidden, 8, bias=False)
+
+    def forward(self, pixels):
+        x = self.model.visual(pixels).to(torch.bfloat16)
+        for layer in self.model.layers:
+            x = layer(x)
+        return self.lm_head(x)
+
+
+@pytest.fixture(scope="module")
+def mesh():
+    os.environ.setdefault("MASTER_ADDR", "127.0.0.1")
+    os.environ.setdefault("MASTER_PORT", "29533")
+    dist.init_process_group("nccl", rank=0, world_size=1)
+    torch.cuda.set_device(0)
+    yield init_device_mesh("cuda", (1,))
+    dist.destroy_process_group()
+
+
+@pytest.mark.parametrize("tf32", [False, True])
+def test_fp32_modules_compute_in_fp32_and_the_rest_in_bf16(mesh, tf32):
+    torch.manual_seed(0)
+    model = MockVLM().cuda()
+    seen = {}
+
+    def record(name):
+        # input, weight and output dtype of a linear layer: under autocast the output shows what the matmul ran in
+        def hook(module, args, out):
+            seen[name] = (args[0].dtype, module.weight.dtype, out.dtype)
+
+        return hook
+
+    model.model.visual.blocks[0].fc.register_forward_hook(record("vision block"))
+    model.model.visual.patch.register_forward_hook(record("vision patch"))
+    model.model.layers[0].fc.register_forward_hook(record("decoder layer"))
+    fsdp_kwargs = {
+        "mesh": mesh,
+        "mp_policy": MixedPrecisionPolicy(param_dtype=torch.bfloat16, reduce_dtype=torch.float32),
+    }
+
+    apply_fsdp2(model, fsdp_kwargs, {"mixed_precision": {"fp32_modules": ["model.visual"], "fp32_modules_tf32": tf32}})
+    # the engine runs its forward under autocast in the param dtype (FSDPEngine's autocast_ctx)
+    with torch.autocast(device_type="cuda", dtype=torch.bfloat16):
+        out = model(torch.randn(3, 64, device="cuda", dtype=torch.bfloat16))
+    out.float().sum().backward()
+
+    # the vision tower's own parameters (patch, pos_embed) and its blocks gather and compute in fp32
+    assert seen["vision patch"] == (torch.float32, torch.float32, torch.float32)
+    assert seen["vision block"] == (torch.float32, torch.float32, torch.float32)
+    assert seen["decoder layer"] == (torch.bfloat16, torch.bfloat16, torch.bfloat16)
+    assert model.model.visual.config._attn_implementation == "sdpa"
+    assert torch.backends.cuda.matmul.allow_tf32 == tf32 and torch.backends.cudnn.allow_tf32 == tf32
+    assert all(p.grad is not None for p in model.model.visual.parameters())
diff --git a/verl/utils/fsdp_utils.py b/verl/utils/fsdp_utils.py
index 13c1bd321f05af689a7a43550215f032403c8037..fa39ff2170832a7efae08569aba02114e68df56b 100644
--- a/verl/utils/fsdp_utils.py
+++ b/verl/utils/fsdp_utils.py
@@ -570,6 +570,17 @@ def _select_fsdp2_wrap_targets(model, fsdp_transformer_layer_cls_to_wrap):
     return modules
 
 
+def _autocast_disabled(forward):
+    """``forward`` with autocast turned off while it runs."""
+
+    @functools.wraps(forward)
+    def wrapped(*args, **kwargs):
+        with torch.autocast(device_type=get_device_name(), enabled=False):
+            return forward(*args, **kwargs)
+
+    return wrapped
+
+
 def apply_fsdp2(model, fsdp_kwargs, config):
     """model: AutoModelForCausalLM"""
     assert CPUOffloadPolicy is not None, "PyTorch version >= 2.4 is required for using fully_shard API (FSDP2)"
@@ -588,11 +599,36 @@ def apply_fsdp2(model, fsdp_kwargs, config):
 
     modules = _select_fsdp2_wrap_targets(model, fsdp_transformer_layer_cls_to_wrap)
 
+    # mixed_precision.fp32_modules: submodules (by name) that gather their parameters and compute in fp32, each one unit
+    # of its own over the wrapped layers inside it; a rollout engine must compute them in fp32 as well
+    mixed_precision = config.get("mixed_precision") or {}
+    fp32_roots = [model.get_submodule(name) for name in mixed_precision.get("fp32_modules", [])]
+    fp32_members = {id(member) for root in fp32_roots for member in root.modules()}
+    fp32_kwargs = {
+        **fsdp_kwargs,
+        "mp_policy": MixedPrecisionPolicy(param_dtype=torch.float32, reduce_dtype=torch.float32),
+    }
+    for root in fp32_roots:
+        # flash-attention kernels have no fp32 path
+        if hasattr(getattr(root, "config", None), "_attn_implementation"):
+            root.config._attn_implementation = "sdpa"
+    if fp32_roots:
+        # their matmuls and convolutions in IEEE fp32 (cudnn's default TF32 rounds inputs to 10 mantissa bits) or on
+        # TF32 tensor cores (fp32_modules_tf32); process-wide flags, but every other matmul runs in bf16 under autocast
+        tf32 = mixed_precision.get("fp32_modules_tf32", False)
+        torch.backends.cuda.matmul.allow_tf32 = tf32
+        torch.backends.cudnn.allow_tf32 = tf32
+
     for idx, module in enumerate(modules):
         # if torch.distributed.is_initialized() and torch.distributed.get_rank() == 0:
         #     print(f"wrap module {module.__class__.__name__}")
         with maybe_patch_fsdp_module(module):
-            fully_shard(module, **fsdp_kwargs)
+            fully_shard(module, **(fp32_kwargs if id(module) in fp32_members else fsdp_kwargs))
+    for root in fp32_roots:
+        with maybe_patch_fsdp_module(root):
+            fully_shard(root, **fp32_kwargs)
+        # the engine runs the forward under autocast in param_dtype, which would lower these modules' matmuls back to it
+        root.forward = _autocast_disabled(root.forward)
 
     # if torch.distributed.is_initialized() and torch.distributed.get_rank() == 0:
     #     print(f"wrap module {model.__class__.__name__}")
