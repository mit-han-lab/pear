+def test_dapo_keeps_a_group_of_equal_rewards_whose_advantages_the_length_penalty_sets_apart(tq_init, partition_id):
+    groups = {
+        "lengths_differ": ([1.0, 1.0], [100, 200]),
+        "lengths_equal": ([1.0, 1.0], [100, 100]),
+        "unsolved": ([0.0, 0.0], [100, 200]),
+    }
+    specs = {
+        name: PromptSpec(uid=_uid(), status="finished", sessions=2, canonical_rewards=rewards, generated_tokens=lengths)
+        for name, (rewards, lengths) in groups.items()
+    }
+    _produce(partition_id, list(specs.values())).join_and_check()
+    uids = {spec.uid for spec in specs.values()}
+
+    length_penalty = functools.partial(
+        get_adv_estimator_fn("grpo_length_penalty"), config=OmegaConf.create({"length_penalty_coeff": 0.5})
+    )
+
+    try:
+        # with no estimator to ask every group is filtered; the length penalty keeps successes of different lengths
+        for advantage_fn, kept_uids in ((None, set()), (length_penalty, {specs["lengths_differ"].uid})):
+            rb = _make_rb(
+                filter_groups_metric="reward", refill_fn=lambda _n: None, filter_groups_advantage_fn=advantage_fn
+            )
+            rb._sync_metadata_from_transfer_queue()
+            filtered_uids, _ = rb._dapo_filtered_keys(partition_id)
+
+            assert uids - filtered_uids == kept_uids
+    finally:
+        _clear_partition(partition_id)
+
+
