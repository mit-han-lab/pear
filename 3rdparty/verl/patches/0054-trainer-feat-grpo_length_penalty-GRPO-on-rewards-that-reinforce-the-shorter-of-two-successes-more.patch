+def get_length_penalty_coeff(config: Optional[AlgoConfig]) -> float:
+    """
+    Read ``algorithm.length_penalty_coeff``, which grpo_length_penalty requires finite and non-negative.
+
+    Args:
+        config: (AlgoConfig) algorithm settings
+
+    Returns:
+        coeff: the exponent of a success's generated tokens over those of its group's shortest success
+    """
+    coeff = None if config is None else config.get("length_penalty_coeff", None)
+    if coeff is None or not (math.isfinite(coeff) and coeff >= 0):
+        raise ValueError(
+            f"grpo_length_penalty needs algorithm.length_penalty_coeff, finite and non-negative, not {coeff}"
+        )
+    return float(coeff)
+
+
+def apply_length_penalty(rewards: torch.Tensor, lengths: torch.Tensor, coeff: float) -> torch.Tensor:
+    """
+    Shape the rewards of one group by the length penalty: a success's reward (exactly 1.0) becomes
+    max(1, L / L_min) ** -coeff, L the tokens it generated and L_min those of the group's shortest success; the other
+    rewards stay as they are.
+
+    Args:
+        rewards: (group_size,) outcome rewards
+        lengths: (group_size,) generated tokens of each response
+        coeff: the penalty's exponent; 0 leaves the rewards as they are
+
+    Returns:
+        shaped rewards: (group_size,)
+    """
+    successes = rewards == 1.0
+    if not successes.any():
+        return rewards
+
+    lengths = lengths.to(rewards.dtype)
+    shortest = lengths[successes].min()
+    return torch.where(successes, (lengths / shortest).clamp(min=1.0) ** -coeff, rewards)
+
+
+@register_adv_est(AdvantageEstimator.GRPO_LENGTH_PENALTY)  # or simply: @register_adv_est("grpo_length_penalty")
+def compute_grpo_length_penalty_outcome_advantage(
+    token_level_rewards: torch.Tensor,
+    response_mask: torch.Tensor,
+    index: np.ndarray,
+    epsilon: float = 1e-6,
+    config: Optional[AlgoConfig] = None,
+    **kwargs,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """
+    Compute GRPO advantages on outcome rewards shaped by the length penalty (``apply_length_penalty``), so that of
+    two successes of a group the shorter one is reinforced more.
+
+    A group with a failure is normalized as in GRPO. A group whose responses all succeeded differs by length alone
+    and is only centered on its mean: divided by its std, a small length difference would weigh as much as a success
+    against a failure. A group of one keeps its reward, as in GRPO.
+
+    Args:
+        token_level_rewards: (bs, response_length)
+        response_mask: (bs, response_length), the generated tokens
+        index: (bs,) → group ID per sample
+        epsilon: float for numerical stability
+        config: (AlgoConfig) algorithm settings, which contains "length_penalty_coeff" and "norm_adv_by_std_in_grpo"
+
+    Returns:
+        advantages: (bs, response_length)
+        returns: (bs, response_length)
+    """
+    coeff = get_length_penalty_coeff(config)
+    norm_adv_by_std_in_grpo = config.get("norm_adv_by_std_in_grpo", True)
+    rewards = token_level_rewards.sum(dim=-1)
+    lengths = response_mask.sum(dim=-1)
+    scores = torch.zeros_like(rewards)
+
+    id2rows = defaultdict(list)
+
+    with torch.no_grad():
+        bsz = rewards.shape[0]
+        for i in range(bsz):
+            id2rows[index[i]].append(i)
+        for idx in id2rows:
+            rows = torch.tensor(id2rows[idx], device=rewards.device)
+            shaped = apply_length_penalty(rewards[rows], lengths[rows], coeff)
+            if len(rows) == 1:
+                scores[rows] = shaped
+                continue
+
+            centered = shaped - shaped.mean()
+            if norm_adv_by_std_in_grpo and not bool((rewards[rows] == 1.0).all()):
+                centered = centered / (shaped.std() + epsilon)
+            scores[rows] = centered
+        scores = scores.unsqueeze(-1) * response_mask
+
+    return scores, scores
+
+
