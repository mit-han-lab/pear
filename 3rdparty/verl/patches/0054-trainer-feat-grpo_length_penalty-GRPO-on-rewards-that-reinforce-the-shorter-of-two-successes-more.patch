@@ -0,0 +1,98 @@
+import math
+
+import numpy as np
+import pytest
+import torch
+from omegaconf import OmegaConf
+
+from verl.trainer.ppo.core_algos import (
+    AdvantageEstimator,
+    apply_length_penalty,
+    compute_grpo_outcome_advantage,
+    get_adv_estimator_fn,
+    get_length_penalty_coeff,
+)
+
+
+def _responses(rewards: list[float], lengths: list[int]) -> tuple[torch.Tensor, torch.Tensor]:
+    """token_level_rewards and response_mask of responses with these rewards and generated tokens, each reward on its
+    response's last generated token."""
+    token_level_rewards = torch.zeros(len(lengths), max(lengths))
+    response_mask = torch.zeros(len(lengths), max(lengths))
+    for row, (reward, length) in enumerate(zip(rewards, lengths, strict=True)):
+        token_level_rewards[row, length - 1] = reward
+        response_mask[row, :length] = 1
+
+    return token_level_rewards, response_mask
+
+
+def _advantages(rewards: list[float], lengths: list[int], groups: list[str], **config) -> list[float]:
+    """Each response's advantage under the registered estimator, which gives the same value to all its tokens."""
+    token_level_rewards, response_mask = _responses(rewards, lengths)
+
+    advantages, returns = get_adv_estimator_fn(AdvantageEstimator.GRPO_LENGTH_PENALTY)(
+        token_level_rewards=token_level_rewards,
+        response_mask=response_mask,
+        index=np.array(groups, dtype=object),
+        config=OmegaConf.create(config),
+    )
+
+    assert torch.equal(returns, advantages)
+    assert torch.equal(advantages, advantages[:, :1] * response_mask)
+    return advantages[:, 0].tolist()
+
+
+def test_a_success_s_reward_falls_with_its_length_over_the_group_s_shortest_success():
+    shaped = apply_length_penalty(torch.tensor([1.0, 1.0, 1.0, 0.0]), torch.tensor([100, 200, 150, 50]), 1.0)
+
+    # the failure, though the shortest, keeps its reward and is no reference
+    assert shaped.tolist() == pytest.approx([1.0, 0.5, 2 / 3, 0.0])
+
+
+def test_a_group_without_a_success_keeps_its_rewards():
+    rewards = torch.tensor([0.0, 0.5])
+
+    assert torch.equal(apply_length_penalty(rewards, torch.tensor([10, 20]), 1.0), rewards)
+
+
+def test_without_a_penalty_the_advantages_are_grpo_s():
+    rewards, lengths = [1.0, 0.0, 1.0, 1.0, 1.0, 0.0, 0.0], [10, 30, 20, 40, 50, 60, 70]
+    groups = ["mixed"] * 3 + ["solved"] * 2 + ["unsolved"] * 2
+    token_level_rewards, response_mask = _responses(rewards, lengths)
+
+    grpo, _ = compute_grpo_outcome_advantage(token_level_rewards, response_mask, np.array(groups, dtype=object))
+
+    assert _advantages(rewards, lengths, groups, length_penalty_coeff=0.0) == pytest.approx(grpo[:, 0].tolist())
+
+
+def test_a_group_with_a_failure_is_divided_by_its_std_and_a_group_of_successes_only_centered():
+    advantages = _advantages(
+        [1.0, 1.0, 0.0, 1.0, 1.0], [100, 200, 100, 100, 200], ["mixed"] * 3 + ["solved"] * 2, length_penalty_coeff=1.0
+    )
+
+    # mixed: shaped 1, 0.5 and 0, mean 0.5, std 0.5; solved: shaped 1 and 0.5, mean 0.75
+    assert advantages == pytest.approx([1.0, 0.0, -1.0, 0.25, -0.25], abs=1e-5)
+
+
+def test_without_the_std_every_group_is_only_centered():
+    advantages = _advantages(
+        [1.0, 1.0, 0.0], [100, 200, 100], ["mixed"] * 3, length_penalty_coeff=1.0, norm_adv_by_std_in_grpo=False
+    )
+
+    assert advantages == pytest.approx([0.5, 0.0, -0.5])
+
+
+def test_a_group_of_one_keeps_its_reward():
+    assert _advantages([1.0], [100], ["alone"], length_penalty_coeff=1.0) == [1.0]
+
+
+@pytest.mark.parametrize("config", [{}, {"length_penalty_coeff": None}, {"length_penalty_coeff": -0.1}])
+def test_the_estimator_refuses_a_missing_or_negative_coefficient(config):
+    with pytest.raises(ValueError, match="length_penalty_coeff"):
+        _advantages([1.0, 0.0], [10, 20], ["a", "a"], **config)
+
+
+@pytest.mark.parametrize("coeff", [math.inf, math.nan])
+def test_a_coefficient_that_is_not_finite_is_refused(coeff):
+    with pytest.raises(ValueError, match="length_penalty_coeff"):
+        get_length_penalty_coeff(OmegaConf.create({"length_penalty_coeff": coeff}))
