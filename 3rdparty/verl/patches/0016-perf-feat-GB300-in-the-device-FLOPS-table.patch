From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pear <pear@localhost>
Date: Mon, 17 Sep 2001 00:00:00 +0000
Subject: [PATCH] [perf] feat: GB300 in the device FLOPS table

A device missing from the table gets an infinite peak, which turns every MFU into 0. GB300 is listed at
2.5 PFLOPS, the rate of GB200.
---
 tests/utils/test_flops_counter.py | 8 +++++++-
 verl/utils/flops_counter.py       | 1 +
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/tests/utils/test_flops_counter.py b/tests/utils/test_flops_counter.py
index a75336667e236813a072f8ceeebb83a79ba62913..0a57e72e2485f8fff235f2111df2c967d20b84a4 100644
--- a/tests/utils/test_flops_counter.py
+++ b/tests/utils/test_flops_counter.py
@@ -16,7 +16,7 @@ import math
 
 import pytest
 
-from verl.utils.flops_counter import FlopsCounter
+from verl.utils.flops_counter import FlopsCounter, get_device_flops
 
 VALID_CONFIG_TYPE = {
     "llama",
@@ -570,3 +570,9 @@ def test_flops_counter(config_type: str):
             assert math.isclose(counted_flops, expected_flops), (
                 f"Expect flops for {test_config['config']} is {expected_flops}, but get {counted_flops}"
             )
+
+
+def test_gb300_has_a_peak():
+    # an unknown device gets an infinite peak, which turns every MFU into 0
+    assert math.isclose(get_device_flops(unit="P", device_name="NVIDIA GB300"), 2.5)
+    assert math.isclose(get_device_flops(unit="P", device_name="NVIDIA B200"), 2.25)
diff --git a/verl/utils/flops_counter.py b/verl/utils/flops_counter.py
index 376d806c1aa26c06dcd8a042c825598f28fa2afb..75c9676a7081b63f9cdbdce6dcb13f7f8d755eaf 100644
--- a/verl/utils/flops_counter.py
+++ b/verl/utils/flops_counter.py
@@ -22,6 +22,7 @@ from verl.utils.device import get_torch_device
 _DEVICE_FLOPS = {
     "CPU": 448e9,
     "GB200": 2.5e15,
+    "GB300": 2.5e15,
     "B200": 2.25e15,
     "MI300X": 1307e12,
     "MI350X": 2300e12,
